@page "/settings"
@using BasicSheets.Shared.Services
@using BasicSheets.Shared.Models
@inject SettingsService SettingsService
@inject IJSRuntime JS

<PageTitle>Einstellungen</PageTitle>

<div class="pg-title">Einstellungen</div>

<div class="main-container">

    @RenderSection("Darstellung", s => s.Name is "Dunkles Design" or "Stiftdicke" or "Stiftfarbe")
    @RenderSection("Ansicht",     s => s.Name is "Seitenansicht" or "Viewer-Hintergrund" or "Seitenzahlen")
    @RenderSection("Verhalten",   s => s.Name is "Start und End Hinweis" or "Toolbar automatisch ausblenden"
                                    or "Letzte Seite merken" or "Seiten automatisch umblättern"
                                    or "Seitenübergang animieren")
    @RenderSection("Annotieren",  s => s.Name is "Standard-Notizwerkzeug")
    @RenderSection("Gerät",       s => s.Name is "Bildschirm wach halten" or "Sortierung")
    @RenderSection("Stift",       s => s.Name is "Stift: Bearbeitungsmodus" or "Stift: Seitentaste")
    @RenderSection("Gesten",      s => s.Name.StartsWith("Geste:"))

</div>

@code {
    private RenderFragment RenderSection(string title, Func<Setting, bool> filter) => builder =>
    {
        var items = SettingsService.GetSettings().Where(filter).ToList();
        if (items.Count == 0) return;

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "settings-section");

        builder.OpenElement(2, "div");
        builder.AddAttribute(3, "class", "settings-section-title");
        builder.AddContent(4, title);
        builder.CloseElement();

        builder.OpenElement(5, "div");
        builder.AddAttribute(6, "class", "settings-list");

        int seq = 10;
        foreach (var s in items)
        {
            var setting = s;
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "setting-card");

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "setting-header");

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "setting-info");
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "setting-name");
            builder.AddContent(seq++, setting.Name);
            builder.CloseElement();
            if (!string.IsNullOrEmpty(setting.Description))
            {
                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "setting-desc");
                builder.AddContent(seq++, setting.Description);
                builder.CloseElement();
            }
            builder.CloseElement(); // setting-info

            builder.CloseElement(); // setting-header

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "setting-ctrl");

            if (setting.Type == "toggle")
            {
                builder.OpenElement(seq++, "label");
                builder.AddAttribute(seq++, "class", "switch");
                builder.OpenElement(seq++, "input");
                builder.AddAttribute(seq++, "type", "checkbox");
                builder.AddAttribute(seq++, "checked", setting.Value == "true");
                builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => ToggleSetting(setting)));
                builder.CloseElement();
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "slider");
                builder.CloseElement();
                builder.CloseElement(); // label
            }
            else if (setting.Type == "select" && setting.Options != null)
            {
                string groupCls = setting.Options.Count > 3 ? "seg-group seg-group-v" : "seg-group";
                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", groupCls);
                foreach (var opt in setting.Options)
                {
                    var parts = opt.Split('|', 2);
                    var val   = parts[0];
                    var lbl   = parts.Length > 1 ? parts[1] : parts[0];
                    var capturedVal = val;
                    builder.OpenElement(seq++, "button");
                    builder.AddAttribute(seq++, "class", "seg-btn" + (setting.Value == val ? " seg-btn-on" : ""));
                    builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => SelectSetting(setting, capturedVal)));
                    builder.AddContent(seq++, lbl);
                    builder.CloseElement();
                }
                builder.CloseElement(); // seg-group
            }

            builder.CloseElement(); // setting-ctrl
            builder.CloseElement(); // setting-card
        }

        builder.CloseElement(); // settings-list
        builder.CloseElement(); // settings-section
    };

    private async Task ToggleSetting(Setting setting)
    {
        setting.Value = setting.Value == "true" ? "false" : "true";
        SettingsService.SaveSettings();
        if (setting.Name == "Dunkles Design")
            await JS.InvokeVoidAsync("setDarkMode", setting.Value == "true");
    }

    private void SelectSetting(Setting setting, string value)
    {
        setting.Value = value;
        SettingsService.SaveSettings();
    }

}
