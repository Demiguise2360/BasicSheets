@page "/upload"
@using BasicSheets.Shared.Services
@using BasicSheets.Shared.Models;
@inject SheetService SheetService;
@inject NavigationManager navigationManager;

<PageTitle>Noten hinzufügen</PageTitle>

<div class="pg-title">Noten hinzufügen</div>

<div class="main-container-large">
    <div class="upload-card">

        @* File picker *@
        <div class="file-zone @(pickedFileName != null ? "file-zone-ok" : "")"
             @onclick="PickFile">
            @if (pickedFileName != null)
            {
                <div class="file-chosen-info">
                    <span class="file-chosen-icon">&#x1F4C4;</span>
                    <span class="file-chosen">@pickedFileName</span>
                    <span class="file-size">@FormatSize(pickedFileSize)</span>
                </div>
            }
            else
            {
                <div class="file-hint-inner">
                    <span class="file-hint-icon">&#x2795;</span>
                    <span class="file-hint">PDF auswählen</span>
                    <span class="file-hint-sub">Tippe, um eine Datei auszuwählen</span>
                </div>
            }
        </div>

        @if (fileError != null)
        {
            <p class="field-error">@fileError</p>
        }

        @* ── Basis ── *@
        <div class="form-group">
            <label class="field-label">Name *</label>
            <input class="field-input" placeholder="Name der Noten" @bind="sheet.Name" />
        </div>

        <div class="form-group">
            <label class="field-label">Komponist</label>
            <input class="field-input" placeholder="z.B. Ludwig van Beethoven" @bind="sheet.Composer" />
        </div>

        <div class="form-group">
            <label class="field-label">Stimme / Instrument</label>
            <input class="field-input" placeholder="z.B. Geige, Klavier" @bind="sheet.Part" />
        </div>

        @* ── Details ── *@
        <div class="edit-section-label">Details</div>

        <div class="form-row-2">
            <div class="form-group">
                <label class="field-label">Genre</label>
                <input class="field-input" placeholder="z.B. Klassik, Jazz" @bind="sheet.Genre" />
            </div>
            <div class="form-group">
                <label class="field-label">Jahr</label>
                <input class="field-input" placeholder="z.B. 1820" @bind="sheet.Year" />
            </div>
        </div>

        <div class="form-group">
            <label class="field-label">Schwierigkeit</label>
            <div class="seg-group">
                <button class="seg-btn @(sheet.Difficulty==""?"seg-btn-on":"")"
                        @onclick='()=>{ sheet.Difficulty = ""; }'>—</button>
                <button class="seg-btn @(sheet.Difficulty=="beginner"?"seg-btn-on":"")"
                        @onclick='()=>{ sheet.Difficulty = "beginner"; }'>Anfänger</button>
                <button class="seg-btn @(sheet.Difficulty=="intermediate"?"seg-btn-on":"")"
                        @onclick='()=>{ sheet.Difficulty = "intermediate"; }'>Mittel</button>
                <button class="seg-btn @(sheet.Difficulty=="advanced"?"seg-btn-on":"")"
                        @onclick='()=>{ sheet.Difficulty = "advanced"; }'>Fortg.</button>
                <button class="seg-btn @(sheet.Difficulty=="expert"?"seg-btn-on":"")"
                        @onclick='()=>{ sheet.Difficulty = "expert"; }'>Experte</button>
            </div>
        </div>

        <div class="form-group">
            <label class="field-label">Tags <span class="field-hint">(kommagetrennt)</span></label>
            <input class="field-input" placeholder="z.B. Etüde, Übung" @bind="sheet.Tags" />
        </div>

        <div class="form-group">
            <label class="field-label">Bemerkungen</label>
            <textarea class="field-input field-textarea" @bind="sheet.Remarks"
                      placeholder="Notizen, Übehinweise …" rows="3"></textarea>
        </div>

        <button class="submit-btn" @onclick="SaveSheet"
                disabled="@(pickedFilePath == null || string.IsNullOrWhiteSpace(sheet.Name) || isUploading)">
            @if (isUploading) { <span>Wird gespeichert&#x2026;</span> }
            else              { <span>Hinzufügen</span> }
        </button>

    </div>
</div>

@code {
    [Inject] private IFilePickerService? FilePickerService { get; set; }

    private Sheet sheet = new();
    private string? pickedFileName;
    private string? pickedFilePath;
    private long pickedFileSize;
    private string? fileError;
    private bool isUploading;
    private static readonly Random Rng = new();
    private const long MaxFileSize = 30L * 1024 * 1024;

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024)       return $"{bytes} B";
        if (bytes < 1024*1024)  return $"{bytes/1024.0:F1} KB";
        return $"{bytes/(1024.0*1024):F1} MB";
    }

    private static string CleanFileName(string name)
    {
        var n = System.IO.Path.GetFileNameWithoutExtension(name);
        n = n.Replace('_', ' ').Replace('-', ' ');
        while (n.Contains("  ")) n = n.Replace("  ", " ");
        return n.Trim();
    }

    private async Task PickFile()
    {
        if (FilePickerService == null) return;
        fileError = null;

        try
        {
            var result = await FilePickerService.PickPdfAsync();
            if (result == null) return;

            if (!result.FileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            {
                fileError = "Bitte eine PDF-Datei auswählen.";
                return;
            }

            if (result.Size > MaxFileSize)
            {
                fileError = "Datei zu groß (max. 30 MB).";
                return;
            }

            pickedFileName = result.FileName;
            pickedFilePath = result.FullPath;
            pickedFileSize = result.Size;

            if (string.IsNullOrWhiteSpace(sheet.Name))
                sheet.Name = CleanFileName(result.FileName);
        }
        catch (Exception ex)
        {
            fileError = $"Datei konnte nicht ausgewählt werden: {ex.Message}";
        }
    }

    private static string RandomName() =>
        new string(Enumerable.Repeat("abcdefghijklmnopqrstuvwxyz0123456789", 20)
            .Select(s => s[Rng.Next(s.Length)]).ToArray());

    private async Task SaveSheet()
    {
        if (pickedFilePath == null || string.IsNullOrWhiteSpace(sheet.Name)) return;

        isUploading = true;
        StateHasChanged();

        try
        {
            string fileName = RandomName() + ".pdf";
            string folder = SheetService.UploadFolder;
            Directory.CreateDirectory(folder);
            string destPath = Path.Combine(folder, fileName);

            await using var source = new FileStream(pickedFilePath, FileMode.Open, FileAccess.Read);
            await using var dest = new FileStream(destPath, FileMode.Create, FileAccess.Write);
            await source.CopyToAsync(dest);

            sheet.FilePath = $"uploads/{fileName}";
            SheetService.AddSheets(sheet);
            navigationManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            fileError = $"Fehler beim Speichern: {ex.Message}";
            isUploading = false;
        }
    }
}
