@page "/edit/{fileName}"
@using BasicSheets.Shared.Services
@using BasicSheets.Shared.Models
@inject SheetService SheetService
@inject CollectionService CollectionService
@inject SheetFileService SheetFileService
@inject NavigationManager navigationManager

<PageTitle>Bearbeiten</PageTitle>

<div class="pg-title">Bearbeiten</div>

<div class="main-container-large">
    @if (notFound)
    {
        <div class="empty-state">
            <p class="empty-title">Noten nicht gefunden</p>
            <p class="empty-sub">Diese Noten existieren nicht mehr oder wurden gelöscht.</p>
            <button class="submit-btn" style="margin-top:1rem" @onclick='() => navigationManager.NavigateTo("/")'>Zurück zur Übersicht</button>
        </div>
    }
    else
    {
        <div class="upload-card">

            <div class="file-zone @(selectedFile != null ? "file-zone-ok" : "")">
                <InputFile OnChange="OnFileSelected" accept="application/pdf,.pdf" id="pdf-edit-input" />
                <label for="pdf-edit-input" class="file-zone-label">
                    @if (selectedFile != null)
                    {
                        <span class="file-chosen">@selectedFile.Name</span>
                    }
                    else
                    {
                        <span class="file-hint">Neue PDF (optional)</span>
                    }
                </label>
            </div>

            @if (fileError != null)
            {
                <p class="field-error">@fileError</p>
            }

            @* ── Basis ── *@
            <div class="edit-section-label">Basis</div>

            <div class="form-group">
                <label class="field-label">Name *</label>
                <input class="field-input" @bind="sheet.Name" />
            </div>
            <div class="form-group">
                <label class="field-label">Komponist</label>
                <input class="field-input" @bind="sheet.Composer" />
            </div>
            <div class="form-group">
                <label class="field-label">Stimme / Instrument</label>
                <input class="field-input" @bind="sheet.Part" />
            </div>

            @* ── Details ── *@
            <div class="edit-section-label">Details</div>

            <div class="form-row-2">
                <div class="form-group">
                    <label class="field-label">Genre</label>
                    <input class="field-input" @bind="sheet.Genre" placeholder="z.B. Klassik" />
                </div>
                <div class="form-group">
                    <label class="field-label">Jahr</label>
                    <input class="field-input" @bind="sheet.Year" placeholder="z.B. 1820" />
                </div>
            </div>

            <div class="form-group">
                <label class="field-label">Schwierigkeit</label>
                <div class="seg-group">
                    <button class="seg-btn @(sheet.Difficulty==""?"seg-btn-on":"")"
                            @onclick='()=>{ sheet.Difficulty = ""; }'>—</button>
                    <button class="seg-btn @(sheet.Difficulty=="beginner"?"seg-btn-on":"")"
                            @onclick='()=>{ sheet.Difficulty = "beginner"; }'>Anfänger</button>
                    <button class="seg-btn @(sheet.Difficulty=="intermediate"?"seg-btn-on":"")"
                            @onclick='()=>{ sheet.Difficulty = "intermediate"; }'>Mittel</button>
                    <button class="seg-btn @(sheet.Difficulty=="advanced"?"seg-btn-on":"")"
                            @onclick='()=>{ sheet.Difficulty = "advanced"; }'>Fortg.</button>
                    <button class="seg-btn @(sheet.Difficulty=="expert"?"seg-btn-on":"")"
                            @onclick='()=>{ sheet.Difficulty = "expert"; }'>Experte</button>
                </div>
            </div>

            <div class="form-group">
                <label class="field-label">Tags <span class="field-hint">(kommagetrennt)</span></label>
                <input class="field-input" @bind="sheet.Tags" placeholder="z.B. Etüde, Übung" />
            </div>

            <div class="form-group">
                <label class="field-label">Bemerkungen</label>
                <textarea class="field-input field-textarea" @bind="sheet.Remarks"
                          placeholder="Notizen, Übehinweise …" rows="3"></textarea>
            </div>

            <div class="form-group">
                <label class="field-label">Sammlungen</label>
                <div class="coll-chips">
                    @foreach (var c in allCollections)
                    {
                        var cid = c.Id;
                        <button type="button" class="coll-chip @(selectedCollectionIds.Contains(cid) ? "coll-chip-on" : "")"
                                @onclick="() => ToggleCollection(cid)">@c.Name</button>
                    }
                    @if (allCollections.Count == 0)
                    {
                        <span class="field-hint" style="margin:0">Noch keine Sammlungen</span>
                    }
                </div>
                <div class="coll-add">
                    <input class="field-input" placeholder="Neue Sammlung …" @bind="newCollectionName" @bind:event="oninput" />
                    <button type="button" class="coll-add-btn" disabled="@string.IsNullOrWhiteSpace(newCollectionName)" @onclick="AddNewCollection">+</button>
                </div>
            </div>

            @* ── Weitere Dateien (Stimmen / Parts) ── *@
            <div class="edit-section-label">Weitere Dateien</div>

            @if (parts.Count > 0)
            {
                <div class="parts-list">
                    @for (int i = 0; i < parts.Count; i++)
                    {
                        var p = parts[i];
                        var idx = i;
                        <div class="part-row">
                            <input class="field-input part-label" value="@p.Label" placeholder="Bezeichnung"
                                   @onchange="e => OnPartLabelChanged(p.Id, e)" />
                            <span class="part-file">@System.IO.Path.GetFileName(p.Path)</span>
                            <div class="part-ops">
                                <button type="button" class="iconbtn" disabled="@(idx == 0)" @onclick="() => MovePart(p.Id, -1)" title="Nach oben">↑</button>
                                <button type="button" class="iconbtn" disabled="@(idx == parts.Count - 1)" @onclick="() => MovePart(p.Id, 1)" title="Nach unten">↓</button>
                                <button type="button" class="iconbtn iconbtn-del" @onclick="() => RemovePart(p.Id)" title="Entfernen">✕</button>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="part-add">
                <div class="file-zone @(partFile != null ? "file-zone-ok" : "")" style="padding:0.9rem">
                    <InputFile OnChange="OnPartFileSelected" accept="application/pdf,.pdf" id="part-input" />
                    <label for="part-input" class="file-zone-label">
                        <span class="@(partFile != null ? "file-chosen" : "file-hint")">@(partFile?.Name ?? "Zusätzliche PDF (Stimme / Part)")</span>
                    </label>
                </div>
                <div class="coll-add">
                    <input class="field-input" placeholder="Bezeichnung (z.B. Geige)" @bind="partLabel" />
                    <button type="button" class="coll-add-btn" disabled="@(partFile == null)" @onclick="AddPart">+</button>
                </div>
                @if (partError != null) { <p class="field-error">@partError</p> }
            </div>

            @* ── Audio (Begleitung) ── *@
            <div class="edit-section-label">Audio (Begleitung)</div>
            @if (!string.IsNullOrEmpty(sheet.AudioPath))
            {
                <div class="part-row">
                    <span class="part-file">@System.IO.Path.GetFileName(sheet.AudioPath)</span>
                    <div class="part-ops">
                        <button type="button" class="iconbtn iconbtn-del" @onclick="RemoveAudio" title="Entfernen">✕</button>
                    </div>
                </div>
            }
            else
            {
                <div class="part-add">
                    <div class="file-zone @(audioFile != null ? "file-zone-ok" : "")" style="padding:0.9rem">
                        <InputFile OnChange="OnAudioFileSelected" accept="audio/*,.mp3,.m4a,.aac,.ogg,.wav,.flac,.opus" id="audio-input" />
                        <label for="audio-input" class="file-zone-label">
                            <span class="@(audioFile != null ? "file-chosen" : "file-hint")">@(audioFile?.Name ?? "Audiodatei (MP3, M4A, …)")</span>
                        </label>
                    </div>
                    <div class="coll-add">
                        <button type="button" class="coll-add-btn" disabled="@(audioFile == null)" @onclick="AddAudio">+</button>
                    </div>
                </div>
            }
            @if (audioError != null) { <p class="field-error">@audioError</p> }

            @* ── Ansicht ── *@
            <div class="edit-section-label">Ansicht</div>

            <div class="form-group">
                <label class="field-label">Seitenansicht</label>
                <div class="seg-group">
                    <button class="seg-btn @(sheet.PageMode==null?"seg-btn-on":"")"
                            @onclick='()=>{ sheet.PageMode = null; }'>Standard</button>
                    <button class="seg-btn @(sheet.PageMode=="single"?"seg-btn-on":"")"
                            @onclick='()=>{ sheet.PageMode = "single"; }'>Einzelne Seite</button>
                    <button class="seg-btn @(sheet.PageMode=="two"?"seg-btn-on":"")"
                            @onclick='()=>{ sheet.PageMode = "two"; }'>Zwei Seiten</button>
                    <button class="seg-btn @(sheet.PageMode=="half-turn"?"seg-btn-on":"")"
                            @onclick='()=>{ sheet.PageMode = "half-turn"; }'>Halbe Seite</button>
                    <button class="seg-btn @(sheet.PageMode=="scroll-v"?"seg-btn-on":"")"
                            @onclick='()=>{ sheet.PageMode = "scroll-v"; }'>Vertikal scrollen</button>
                </div>
            </div>

            @if (!IsImage(sheet.FilePath))
            {
                <div class="edit-section-label">In Stücke aufteilen</div>
                <p class="field-hint" style="margin:0 0 0.4rem">Teilt diese PDF nach Seitenbereichen in mehrere Stücke auf (sie teilen sich dieselbe Datei).</p>

                @if (splitRanges.Count > 0)
                {
                    <div class="parts-list">
                        @for (int i = 0; i < splitRanges.Count; i++)
                        {
                            var r = splitRanges[i];
                            var idx = i;
                            <div class="split-row">
                                <input class="field-input split-name" placeholder="Name" @bind="r.Name" />
                                <input class="field-input split-pg" type="number" min="1" @bind="r.Start" />
                                <span class="split-dash">–</span>
                                <input class="field-input split-pg" type="number" min="1" @bind="r.End" />
                                <button type="button" class="iconbtn iconbtn-del" @onclick="() => RemoveSplitRange(idx)" title="Entfernen">✕</button>
                            </div>
                        }
                    </div>
                }

                <button type="button" class="add-btn" @onclick="AddSplitRange">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><line x1="12" y1="5" x2="12" y2="19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
                    Bereich hinzufügen
                </button>

                @if (splitRanges.Count > 0)
                {
                    <label class="split-opt"><input type="checkbox" @bind="removeOriginalAfterSplit" /> Original danach entfernen</label>
                    <button type="button" class="submit-btn" style="background:var(--c-warn)" @onclick="DoSplit">In @splitRanges.Count Stück(e) aufteilen</button>
                    @if (splitError != null) { <p class="field-error">@splitError</p> }
                }
            }

            <button class="submit-btn" @onclick="SaveChanges"
                    disabled="@(string.IsNullOrWhiteSpace(sheet.Name) || isSaving)">
                @if (isSaving) { <span>Wird gespeichert…</span> }
                else            { <span>Speichern</span> }
            </button>

        </div>
    }
</div>

@code {
    [Parameter] public string? fileName { get; set; }

    private Sheet sheet = new();
    private IBrowserFile? selectedFile;
    private string? fileError;
    private bool notFound;
    private bool isSaving;
    private const long MaxFileSize = 30L * 1024 * 1024;

    private List<Collection> allCollections = new();
    private HashSet<int> selectedCollectionIds = new();
    private string newCollectionName = "";

    private List<SheetFile> parts = new();
    private IBrowserFile? partFile;
    private string partLabel = "";
    private string? partError;

    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(fileName))
        {
            notFound = true;
            return;
        }

        var found = SheetService.GetSheets().FirstOrDefault(s => Path.GetFileName(s.FilePath) == fileName);
        if (found == null)
        {
            notFound = true;
            return;
        }
        sheet = found;
        allCollections = CollectionService.GetAll();
        selectedCollectionIds = CollectionService.GetForSheet(sheet.Id).Select(c => c.Id).ToHashSet();
        parts = SheetFileService.GetParts(sheet.Id);
    }

    private void OnPartFileSelected(InputFileChangeEventArgs e)
    {
        partFile = e.File;
        partError = (partFile != null && !IsPdf(partFile)) ? "Bitte eine PDF-Datei auswählen." : null;
    }

    private async Task AddPart()
    {
        if (partFile == null) return;
        if (!IsPdf(partFile)) { partError = "Bitte eine PDF-Datei auswählen."; return; }
        if (partFile.Size > MaxFileSize) { partError = "Die Datei ist zu gross (max. 30 MB)."; return; }
        try
        {
            string name = RandomName() + ".pdf";
            Directory.CreateDirectory(SheetService.UploadFolder);
            string dest = Path.Combine(SheetService.UploadFolder, name);
            await using (var fs = new FileStream(dest, FileMode.Create))
                await partFile.OpenReadStream(MaxFileSize).CopyToAsync(fs);

            SheetFileService.AddPart(sheet.Id, $"uploads/{name}", partLabel);
            parts = SheetFileService.GetParts(sheet.Id);
            partFile = null; partLabel = ""; partError = null;
        }
        catch (Exception ex) { partError = $"Fehler: {ex.Message}"; }
    }

    private void RemovePart(int fileId)
    {
        SheetFileService.RemovePart(fileId);
        parts = SheetFileService.GetParts(sheet.Id);
    }

    private void MovePart(int fileId, int dir)
    {
        SheetFileService.Move(sheet.Id, fileId, dir);
        parts = SheetFileService.GetParts(sheet.Id);
    }

    // ── Audio backing track ──────────────────────────────────────────────
    private const long MaxAudioSize = 50L * 1024 * 1024;
    private IBrowserFile? audioFile;
    private string? audioError;
    private void OnAudioFileSelected(InputFileChangeEventArgs e) { audioFile = e.File; audioError = null; }
    private async Task AddAudio()
    {
        if (audioFile == null) return;
        if (audioFile.Size > MaxAudioSize) { audioError = "Die Datei ist zu gross (max. 50 MB)."; return; }
        try
        {
            var ext = Path.GetExtension(audioFile.Name);
            if (string.IsNullOrWhiteSpace(ext)) ext = ".mp3";
            string name = RandomName() + ext.ToLowerInvariant();
            Directory.CreateDirectory(SheetService.UploadFolder);
            string dest = Path.Combine(SheetService.UploadFolder, name);
            await using (var fs = new FileStream(dest, FileMode.Create))
                await audioFile.OpenReadStream(MaxAudioSize).CopyToAsync(fs);
            SheetService.SetAudioPath(sheet.FilePath, name);
            sheet.AudioPath = name;
            audioFile = null; audioError = null;
        }
        catch (Exception ex) { audioError = $"Fehler: {ex.Message}"; }
    }
    private void RemoveAudio()
    {
        SheetService.SetAudioPath(sheet.FilePath, "");
        sheet.AudioPath = "";
    }

    private void OnPartLabelChanged(int fileId, ChangeEventArgs e)
    {
        SheetFileService.UpdateLabel(fileId, e.Value?.ToString() ?? "");
        parts = SheetFileService.GetParts(sheet.Id);
    }

    private static readonly Random _rng = new();
    private static string RandomName() =>
        new string(Enumerable.Repeat("abcdefghijklmnopqrstuvwxyz0123456789", 20).Select(s => s[_rng.Next(s.Length)]).ToArray());

    // ── Page-range splitting ──────────────────────────────────────────────
    private class SplitRange { public string Name = ""; public int Start = 1; public int End = 1; }
    private List<SplitRange> splitRanges = new();
    private bool removeOriginalAfterSplit = true;
    private string? splitError;

    private static readonly string[] ImgExts = { ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp" };
    private static bool IsImage(string? f) =>
        f != null && ImgExts.Any(e => f.EndsWith(e, StringComparison.OrdinalIgnoreCase));

    private void AddSplitRange() => splitRanges.Add(new SplitRange { Start = 1, End = 1 });
    private void RemoveSplitRange(int idx) { if (idx >= 0 && idx < splitRanges.Count) splitRanges.RemoveAt(idx); }

    private void DoSplit()
    {
        var valid = splitRanges.Where(r => r.Start >= 1 && r.End >= r.Start).ToList();
        if (valid.Count == 0) { splitError = "Bitte mindestens einen gültigen Seitenbereich angeben."; return; }

        foreach (var r in valid)
        {
            SheetService.AddSheets(new Sheet
            {
                Name       = string.IsNullOrWhiteSpace(r.Name) ? $"{sheet.Name} ({r.Start}–{r.End})" : r.Name.Trim(),
                FilePath   = sheet.FilePath,
                Composer   = sheet.Composer, Part = sheet.Part, Genre = sheet.Genre,
                Year       = sheet.Year, Difficulty = sheet.Difficulty, Tags = sheet.Tags,
                PageStart  = r.Start, PageEnd = r.End, PageMode = sheet.PageMode
            });
        }

        if (removeOriginalAfterSplit) SheetService.RemoveSheets(sheet);
        navigationManager.NavigateTo("/");
    }

    private void ToggleCollection(int id)
    {
        if (!selectedCollectionIds.Add(id)) selectedCollectionIds.Remove(id);
    }

    private void AddNewCollection()
    {
        var name = (newCollectionName ?? "").Trim();
        if (string.IsNullOrWhiteSpace(name)) return;
        var id = CollectionService.GetOrCreate(name);
        if (id > 0) selectedCollectionIds.Add(id);
        allCollections = CollectionService.GetAll();
        newCollectionName = "";
    }

    private bool IsPdf(IBrowserFile f) =>
        f.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) ||
        f.ContentType.Equals("application/pdf", StringComparison.OrdinalIgnoreCase);

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        fileError = IsPdf(selectedFile) ? null : "Bitte eine PDF-Datei auswählen.";
    }

    private async Task SaveChanges()
    {
        if (string.IsNullOrWhiteSpace(sheet.Name)) return;
        isSaving = true;
        fileError = null;
        StateHasChanged();

        try
        {
            if (selectedFile != null)
            {
                if (!IsPdf(selectedFile))
                {
                    fileError = "Bitte eine PDF-Datei auswählen.";
                    isSaving = false;
                    return;
                }
                if (selectedFile.Size > MaxFileSize)
                {
                    fileError = "Die Datei ist zu gross (max. 30 MB).";
                    isSaving = false;
                    return;
                }

                string folder = SheetService.UploadFolder;
                Directory.CreateDirectory(folder);
                string path = Path.Combine(folder, Path.GetFileName(sheet.FilePath));

                using var fs = new FileStream(path, FileMode.Create);
                await selectedFile.OpenReadStream(MaxFileSize).CopyToAsync(fs);
            }

            SheetService.UpdateSheet(sheet);
            CollectionService.SetSheetCollections(sheet.Id, selectedCollectionIds);
            navigationManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            fileError = $"Fehler beim Speichern: {ex.Message}";
            isSaving = false;
        }
    }
}
