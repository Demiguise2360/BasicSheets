    // ── Init ─────────────────────────────────────────────────────────────
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first)
        {
            if (_needPanelClamp)
            {
                _needPanelClamp = false;
                try { await JS.InvokeVoidAsync("clampPanelIntoView"); } catch { }
            }
            bool topVis = showUi || isEditMode;
            bool botVis = showUi && !isEditMode && pageCount > 1 && !IsScrollMode;
            if (!_chromeInit || topVis != _lastTopVis || botVis != _lastBotVis)
            {
                _chromeInit = true; _lastTopVis = topVis; _lastBotVis = botVis;
                try { await JS.InvokeVoidAsync("updateChromeInsets", topVis, botVis); } catch { }
            }
            return;
        }

        if (string.IsNullOrEmpty(file))
        {
            ShowErrorMessage("Keine Datei angegeben.");
            return;
        }

        _ref = DotNetObjectReference.Create(this);
        viewerBg = SettingsService.GetViewerBackground();

        await LoadColorsAsync();
        await LoadToolStatesAsync();

        currentSheet      = SheetService.GetSheets().FirstOrDefault(s => Path.GetFileName(s.FilePath) == file);
        sheetModeOverride = currentSheet?.PageMode;
        if (sheetModeOverride is "half" or "auto" or "scroll-h")
            sheetModeOverride = null;
        effectiveMode     = sheetModeOverride ?? SettingsService.GetPageMode();

        try
        {
            await JS.InvokeVoidAsync("setPdfDotNetRef", _ref);
            await JS.InvokeVoidAsync("initCanvas", "pdfCanvas", "markerCanvas", "noteCanvas");
        }
        catch (Exception ex)
        {
            ShowErrorMessage($"Canvas konnte nicht initialisiert werden: {ex.Message}");
            return;
        }

        try
        {
            var gestureConfig = new Dictionary<string, string>
            {
                ["swipe_bottom_up"] = SettingsService.GetGestureAction("Geste: Von unten wischen"),
                ["longpress"]       = SettingsService.GetGestureAction("Geste: Lang halten"),
                ["2finger_dbltap"]  = SettingsService.GetGestureAction("Geste: 2 Finger Doppeltippen"),
                ["3finger_left"]    = SettingsService.GetGestureAction("Geste: 3 Finger links"),
                ["3finger_right"]   = SettingsService.GetGestureAction("Geste: 3 Finger rechts"),
            };
            await JS.InvokeVoidAsync("initGestures", gestureConfig);
            await JS.InvokeVoidAsync("initStylusDetection");
            await JS.InvokeVoidAsync("setStylusAutoEdit", SettingsService.StylusAutoEdit());
            await JS.InvokeVoidAsync("setStylusButtonMode", SettingsService.StylusButtonMode());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SheetView] Gesten konnten nicht geladen werden: {ex.Message}");
        }

        try
        {
            panelTop       = (int)Math.Round(await JS.InvokeAsync<double>("loadPanelTop"));
            panelLeft      = (int)Math.Round(await JS.InvokeAsync<double>("loadPanelLeft"));
            panelCollapsed = await JS.InvokeAsync<bool>("loadPanelCollapsed");
            await JS.InvokeVoidAsync("initPanelDrag", _ref);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SheetView] Werkzeug-Palette konnte nicht initialisiert werden: {ex.Message}");
        }

        try
        {
            var filePath = Path.Combine(SheetService.UploadFolder, file);
            if (!File.Exists(filePath))
            {
                ShowErrorMessage($"Die Datei «{file}» wurde nicht gefunden. Möglicherweise wurde sie gelöscht.");
                return;
            }

            var pdfBytes = await File.ReadAllBytesAsync(filePath);
            if (pdfBytes.Length == 0)
            {
                ShowErrorMessage("Die PDF-Datei ist leer und kann nicht geöffnet werden.");
                return;
            }

            totalPages = await JS.InvokeAsync<int>("loadPdfData", file, pdfBytes);
            if (totalPages <= 0)
            {
                ShowErrorMessage("Die PDF-Datei konnte nicht gelesen werden. Ist sie beschädigt?");
                return;
            }

            RecalcPageCount();

            // Generate a first-page thumbnail once (cached), reusing the loaded pdfDoc.
            try
            {
                if (!ThumbnailService.Has(file))
                {
                    var thumb = await JS.InvokeAsync<string?>("renderThumbnail", 180);
                    if (!string.IsNullOrEmpty(thumb))
                        ThumbnailService.Set(file, thumb);
                }
            }
            catch (Exception ex) { Console.WriteLine($"[SheetView] Thumbnail fehlgeschlagen: {ex.Message}"); }

            if (SettingsService.RememberLastPage())
            {
                try
                {
                    var lastPage = await JS.InvokeAsync<int>("loadLastPage", file);
                    if (lastPage > 1 && lastPage <= pageCount)
                        currentPage = lastPage;
                }
                catch { /* last page not critical */ }
            }

            try
            {
                var uri   = new Uri(Nav.Uri);
                var query = uri.Query.TrimStart('?');
                foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
                {
                    var kv = part.Split('=', 2);
                    if (kv.Length == 2 && kv[0] == "page" && int.TryParse(kv[1], out var qPage))
                        if (qPage >= 1 && qPage <= pageCount) currentPage = qPage;
                }
            }
            catch { /* query param parsing not critical */ }

            RefreshPageBookmark();
            await RenderCurrent();
            StateHasChanged();

            if (SettingsService.KeepScreenOn())
                _ = JS.InvokeVoidAsync("setWakeLock", true);

            var animSetting = SettingsService.GetSettings().FirstOrDefault(s => s.Name == "Seitenübergang animieren");
            _ = JS.InvokeVoidAsync("setAnimateTransitions", animSetting?.Value == "true");

            StartAutoPageTurn();
            StartAutoHide();
        }
        catch (JSException ex)
        {
            ShowErrorMessage($"PDF-Viewer Fehler: {ex.Message}");
        }
        catch (IOException ex)
        {
            ShowErrorMessage($"Datei konnte nicht gelesen werden: {ex.Message}");
        }
        catch (Exception ex)
        {
            ShowErrorMessage($"Fehler beim Laden: {ex.Message}");
        }
    }

    private void ShowErrorMessage(string msg)
    {
        showError = true;
        errorMessage = msg;
        StateHasChanged();
    }

    private void RecalcPageCount()
    {
        pageCount = effectiveMode switch
        {
            "two"       => Math.Max(1, totalPages - 1),
            "half-turn" => totalPages * 2,
            "scroll-v"  => 1,
            _           => totalPages
        };
    }

    // ── Auto page turn ────────────────────────────────────────────────────
    private void StartAutoPageTurn()
    {
        StopAutoPageTurn();
        var secs = SettingsService.AutoPageTurnSeconds();
        if (secs <= 0 || IsScrollMode || isEditMode) return;
        _autoTurnCts = new System.Threading.CancellationTokenSource();
        var token = _autoTurnCts.Token;
        Task.Run(async () =>
        {
            while (!token.IsCancellationRequested)
            {
                try { await Task.Delay(secs * 1000, token); }
                catch (OperationCanceledException) { break; }
                if (token.IsCancellationRequested) break;
                if (currentPage < pageCount)
                {
                    try
                    {
                        await InvokeAsync(async () =>
                        {
                            currentPage++;
                            await RenderCurrent();
                            if (SettingsService.RememberLastPage())
                                _ = JS.InvokeVoidAsync("saveLastPage", file, currentPage);
                            StateHasChanged();
                        });
                    }
                    catch { break; }
                }
                else { break; }
            }
        }, token);
    }

    private void StopAutoPageTurn()
    {
        try { _autoTurnCts?.Cancel(); } catch { }
        _autoTurnCts = null;
    }

    // ── Auto-hide toolbar ─────────────────────────────────────────────────
    private void StartAutoHide()
    {
        if (!SettingsService.AutoHideToolbar() || isEditMode) return;
        try { _autoHideCts?.Cancel(); } catch { }
        _autoHideCts = new System.Threading.CancellationTokenSource();
        var token = _autoHideCts.Token;
        Task.Run(async () =>
        {
            try { await Task.Delay(3000, token); }
            catch (OperationCanceledException) { return; }
            if (token.IsCancellationRequested) return;
            try { await InvokeAsync(() => { showUi = false; StateHasChanged(); }); }
            catch { }
        }, token);
    }

    private void ResetAutoHide()
    {
        if (!SettingsService.AutoHideToolbar() || isEditMode) return;
        showUi = true;
        StartAutoHide();
    }

    private void StopAutoHide()
    {
        try { _autoHideCts?.Cancel(); } catch { }
        _autoHideCts = null;
    }

