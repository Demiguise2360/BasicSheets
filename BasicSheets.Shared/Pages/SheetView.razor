    // ── Tool state loader ─────────────────────────────────────────────────
    private async Task LoadToolStatesAsync()
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("getToolStates");
            if (string.IsNullOrEmpty(raw)) return;

            using var doc = System.Text.Json.JsonDocument.Parse(raw);
            var root = doc.RootElement;
            if (root.TryGetProperty("colors", out var colors))
                foreach (var c in colors.EnumerateObject())
                    toolColors[c.Name] = c.Value.GetString() ?? ToolDefaultColors.GetValueOrDefault(c.Name, "#000000");
            if (root.TryGetProperty("sizes", out var sizes))
                foreach (var s in sizes.EnumerateObject())
                    if (s.Value.TryGetInt32(out var sz))
                        toolSizes[s.Name] = Math.Clamp(sz, 1, 20);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SheetView] Tool-Zustände konnten nicht geladen werden: {ex.Message}");
        }
    }

    // ── Tools ────────────────────────────────────────────────────────────
    private async Task SetTool(string t)
    {
        activeTool = t;
        if (!toolColors.ContainsKey(t))
            toolColors[t] = ToolDefaultColors.GetValueOrDefault(t, "#000000");
        if (!toolSizes.ContainsKey(t))
            toolSizes[t] = ToolDefaultSizes.GetValueOrDefault(t, 5);
        activeColor = toolColors[t];
        try { await JS.InvokeVoidAsync("setToolDirect", t, activeColor, toolSizes[t]); }
        catch (Exception ex)
        {
            Console.WriteLine($"[SheetView] Tool konnte nicht gesetzt werden: {ex.Message}");
        }
    }

    private void SetColor(string c)
    {
        activeColor = c;
        toolColors[activeTool] = c;
        _ = JS.InvokeVoidAsync("setColor", c);
    }

