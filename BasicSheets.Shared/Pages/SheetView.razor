    private void OpenBookmarkDialog()
    {
        if (string.IsNullOrEmpty(file)) return;
        int bmPage = IsHalfTurnMode ? (currentPage + 1) / 2 : currentPage;
        existingBookmark = BookmarkService.GetOnPage(file, bmPage);
        bookmarkLabel    = existingBookmark?.Label ?? "";
        bookmarkColor    = existingBookmark?.Color ?? "#4d8a80";
        showBookmarkDialog = true;
    }
    private void CancelBookmark() { showBookmarkDialog = false; }

    private void SaveBookmark()
    {
        if (string.IsNullOrEmpty(file)) return;
        int bmPage = IsHalfTurnMode ? (currentPage + 1) / 2 : currentPage;
        if (existingBookmark != null)
        {
            existingBookmark.Label = bookmarkLabel;
            existingBookmark.Color = bookmarkColor;
            BookmarkService.Update(existingBookmark);
        }
        else
        {
            var name = SheetService.GetSheets()
                           .FirstOrDefault(s => Path.GetFileName(s.FilePath) == file)?.Name ?? file;
            BookmarkService.Add(new Bookmark
            {
                PdfFile   = file,
                SheetName = name,
                Page      = bmPage,
                Label     = bookmarkLabel,
                Color     = bookmarkColor
            });
        }
        RefreshPageBookmark();
        showBookmarkDialog = false;
    }

    private void RemoveBookmark()
    {
        if (existingBookmark != null) BookmarkService.Remove(existingBookmark.Id);
        RefreshPageBookmark();
        showBookmarkDialog = false;
    }

    // ── Gesture handler ───────────────────────────────────────────────────
    // ── Remappable keyboard / pedal keys ──────────────────────────────────
    private string? _capturing;
    private string? _keyCapMsg;
    private async Task CaptureKey(string action)
    {
        _capturing = action;
        _keyCapMsg = "Jetzt die Pedal-/Tastentaste drücken… (Esc = abbrechen)";
        try { await JS.InvokeVoidAsync("setKeyCapture", action); } catch { }
        StateHasChanged();
    }
    private async Task ResetKeys()
    {
        _capturing = null;
        _keyCapMsg = "Tastenbelegung auf Standard zurückgesetzt.";
        try { await JS.InvokeVoidAsync("resetKeyMap"); } catch { }
        StateHasChanged();
    }
    [JSInvokable]
    public Task OnKeyCaptured(string key, string action) => InvokeAsync(() =>
    {
        _capturing = null;
        _keyCapMsg = string.IsNullOrEmpty(action) ? "Abgebrochen." : $"«{KeyName(key)}» → {ActionName(action)}";
        StateHasChanged();
    });
    private static string KeyName(string k) => k switch
    {
        " " or "Spacebar" => "Leertaste", "ArrowRight" => "→", "ArrowLeft" => "←", "ArrowUp" => "↑", "ArrowDown" => "↓",
        "PageUp" => "Bild↑", "PageDown" => "Bild↓", "" => "?", _ => k
    };
    private static string ActionName(string a) => a switch { "next_page" => "Weiter", "prev_page" => "Zurück", _ => a };

    [JSInvokable]
    public async Task OnGesture(string action)
    {
        try
        {
            switch (action)
            {
                case "go_home":
                    await InvokeAsync(() => Nav.NavigateTo("/"));
                    break;
                case "add_bookmark":
                    await InvokeAsync(() => { OpenBookmarkDialog(); StateHasChanged(); });
                    break;
                case "next_page":
                    if (currentPage < pageCount)
                    {
                        currentPage++;
                        RefreshPageBookmark();
                        await InvokeAsync(async () => { await RenderCurrent(); StateHasChanged(); });
                    }
                    else if (HasNextSong)
                    {
                        await InvokeAsync(GoNextSong);
                    }
                    break;
                case "prev_page":
                    if (currentPage > 1)
                    {
                        currentPage--;
                        RefreshPageBookmark();
                        await InvokeAsync(async () => { await RenderCurrent(); StateHasChanged(); });
                    }
                    else if (HasPrevSong)
                    {
                        await InvokeAsync(GoPrevSong);
                    }
                    break;
                case "first_page":
                    currentPage = 1;
                    RefreshPageBookmark();
                    await InvokeAsync(async () => { await RenderCurrent(); StateHasChanged(); });
                    break;
                case "last_page":
                    currentPage = pageCount;
                    RefreshPageBookmark();
                    await InvokeAsync(async () => { await RenderCurrent(); StateHasChanged(); });
                    break;
                case "toggle_edit":
                    await InvokeAsync(async () => { await TakeNotes(); StateHasChanged(); });
                    break;
                case "zoom_reset":
                    await JS.InvokeVoidAsync("fitToWidthPublic");
                    break;
                case "toggle_metronome":
                    await InvokeAsync(async () => { await ToggleMetronome(); });
                    break;
                case "toggle_audio":
                    if (_hasAudio) await InvokeAsync(async () => { await ToggleAudioPlay(); });
                    break;
                case "open_search":
                    if (CanSearch) await InvokeAsync(() => { OpenSearch(); });
                    break;
                case "open_grid":
                    if (CanShowPageGrid) await InvokeAsync(async () => { await OpenPageGrid(); });
                    break;
                case "next_match":
                    if (_showMatchNav && _searchResults.Count > 0) await InvokeAsync(async () => { await MatchNav(1); });
                    break;
                case "prev_match":
                    if (_showMatchNav && _searchResults.Count > 0) await InvokeAsync(async () => { await MatchNav(-1); });
                    break;
                case "toggle_lock":
                    await InvokeAsync(ToggleLock);
                    break;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SheetView] Geste «{action}» fehlgeschlagen: {ex.Message}");
        }
    }

