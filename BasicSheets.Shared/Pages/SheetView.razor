    // ── Tool default colors ───────────────────────────────────────────────
    private static readonly Dictionary<string, string> ToolDefaultColors = new()
    {
        ["pen"]          = "#000000",
        ["marker"]       = "#FFD600",
        ["eraser"]       = "#000000",
        ["text"]         = "#000000",
        ["flat"]         = "#000000",
        ["sharp"]        = "#000000",
        ["natural"]      = "#000000",
        ["double-flat"]  = "#000000",
        ["double-sharp"] = "#000000",
        ["fermata"]      = "#000000",
        ["trill"]        = "#000000",
        ["segno"]        = "#000000",
        ["coda"]         = "#000000",
        ["crescendo"]    = "#000000",
        ["decrescendo"]  = "#000000",
