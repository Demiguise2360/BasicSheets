        catch (Exception ex)
        {
            Console.WriteLine($"[SheetView] Edit-Modus konnte nicht gesetzt werden: {ex.Message}");
            isEditMode = !isEditMode;
            return;
        }

        enableHandleClick = !isEditMode;

        if (isEditMode)
        {
            StopAutoPageTurn();
            await HaltAutoScroll();
            StopAutoHide();
            showUi = true;
