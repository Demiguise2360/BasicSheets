    [JSInvokable]
    public async Task OnAutoScrollEnd(bool moved)
    {
        // Reached the bottom of the current view. In single mode, if we actually
        // scrolled and there's another page, turn it and resume; otherwise stop.
        if (moved && effectiveMode == "single" && currentPage < pageCount)
        {
            await InvokeAsync(async () =>
            {
                currentPage++;
                RefreshPageBookmark();
                await RenderCurrent();
                if (SettingsService.RememberLastPage())
                    _ = JS.InvokeVoidAsync("saveLastPage", file, currentPage);
                StateHasChanged();
            });
            await Task.Delay(500);               // brief breath at the page turn
            if (_autoScrolling)
                try { await JS.InvokeVoidAsync("startAutoScroll", _autoScrollSpeed); } catch { }
        }
        else
        {
            await InvokeAsync(() => { _autoScrolling = false; StateHasChanged(); });
        }
    }

