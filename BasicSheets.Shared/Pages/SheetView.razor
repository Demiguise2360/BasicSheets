    // ── Scroll-mode page stepping (prev/next/first/last + indicator) ───────
    private int _scrollSlot;
    private int ScrollSlotCount => HasPageOrder ? _pageOrder.Count : totalPages;
    private async Task ScrollStep(int delta)
    {
        int s;
        try { s = await JS.InvokeAsync<int>("getScrollSlot"); } catch { s = _scrollSlot; }
        if (s < 0) s = _scrollSlot;
        await ScrollToSlotUi(s + delta);
    }
    private async Task ScrollToSlotUi(int idx)
    {
        idx = Math.Clamp(idx, 0, Math.Max(0, ScrollSlotCount - 1));
        try { await JS.InvokeVoidAsync("scrollToSlot", idx); } catch { }
        _scrollSlot = idx;
        StateHasChanged();
    }
