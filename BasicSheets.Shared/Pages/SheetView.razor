    public void Dispose()
    {
        StopAutoPageTurn();
        StopAutoHide();
        _autoScrolling = false;
        try { _ = JS.InvokeVoidAsync("stopAutoScroll"); } catch { }
        _metroRunning = false;
        try { _ = JS.InvokeVoidAsync("stopMetronome"); } catch { }
        if (_hasAudio) { try { _ = JS.InvokeVoidAsync("saveAudioPos", file ?? "", _audioPos); } catch { } }
        try { _ = JS.InvokeVoidAsync("unloadAudio"); } catch { }
        try { _ = JS.InvokeVoidAsync("disposeKeyNav"); } catch { }
        try { _ = JS.InvokeVoidAsync("setWakeLock", false); } catch { }
        _ref?.Dispose();
    }
