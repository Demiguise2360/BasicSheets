@layout BasicSheets.Shared.Layout.MainLayoutClean
@using BasicSheets.Shared.Services
@using BasicSheets.Shared.Models
@using System.Text.Json
@page "/sheets/{file}"
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject SettingsService SettingsService
@inject SheetService SheetService
@inject BookmarkService BookmarkService
@inject ThumbnailService ThumbnailService
@implements IDisposable

@* ── Full-screen viewer ───────────────────────────────────────────── *@
<div class="vbg vbg-@viewerBg @(isEditMode ? "vbg-edit" : "")" @onclick="HandleClick">
    @if (showStart) { <div class="vnotice"><p>Anfang des Stücks</p></div> }
    @if (showEnd)   { <div class="vnotice"><p>Ende des Stücks</p></div>   }
    @if (showError) { <div class="verror"><p>@errorMessage</p></div>       }
    <div id="page-spinner" class="page-spinner" style="display:none">
        <div class="spinner-ring"></div>
    </div>
    <div id="viewer">
        <canvas id="pdfCanvas"></canvas>
        <canvas id="markerCanvas"></canvas>
        <canvas id="noteCanvas"></canvas>
    </div>
</div>

@* ── Header ───────────────────────────────────────────────────────── *@
<div id="vhdr" class="vhdr @(showUi || isEditMode ? "" : "vhdr-hidden")">

    @if (!isEditMode)
    {
        @* Back *@
        <button class="vhdr-btn" @onclick="GoBack" title="Zurück">
            <img src="/_content/BasicSheets.Shared/icons/arrow.svg" class="vhdr-icon" />
        </button>

        @* Settings *@
        <button class="vhdr-btn @(showQuickPanel && quickPanelTab == 0 ? "vhdr-btn-active" : "")"
                @onclick="() => ToggleQuickPanel(0)"
                title="Einstellungen">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"
                 class="vhdr-icon">
                <circle cx="12" cy="12" r="3"/>
                <path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/>
            </svg>
        </button>

        @* Bookmark shortcut *@
        <button class="vhdr-btn @(showQuickPanel && quickPanelTab == 1 ? "vhdr-btn-active" : "")"
                @onclick="() => ToggleQuickPanel(1)" title="Lesezeichen">
            <img src="/_content/BasicSheets.Shared/icons/bookmark.svg" class="vhdr-icon" />
        </button>

        @* Page mode button *@
        <button class="vhdr-btn @(sheetModeOverride != null ? "vhdr-btn-active" : "")"
                @onclick="ToggleModeDropdown"
                title="Seitenansicht (@GetModeName())">
            <span class="vhdr-mode-sym">@GetModeSym()</span>
        </button>
    }

    @* Page slider / edit-mode nav *@
    @if (isEditMode && pageCount > 1 && !IsScrollMode)
    {
        <div class="vhdr-editnav">
            <button class="vhdr-nav-btn" @onclick="EditPrev" disabled="@(currentPage <= 1)" title="Vorherige Seite">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                     stroke-linecap="round" stroke-linejoin="round" class="vhdr-nav-ico">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
            </button>
            <span class="vhdr-lbl">@currentPage&thinsp;/&thinsp;@pageCount</span>
            <button class="vhdr-nav-btn" @onclick="EditNext" disabled="@(currentPage >= pageCount)" title="Nächste Seite">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                     stroke-linecap="round" stroke-linejoin="round" class="vhdr-nav-ico">
                    <polyline points="9 18 15 12 9 6"/>
                </svg>
            </button>
        </div>
    }
    else
    {
        <div class="vhdr-flex"></div>
    }

    @* Edit toggle *@
    <button class="vhdr-btn @(isEditMode ? "vhdr-btn-done" : "")"
            @onclick="TakeNotes"
            title="@(isEditMode ? "Fertig" : "Annotieren")">
        <img src="@(isEditMode
                    ? "/_content/BasicSheets.Shared/icons/cancel.svg"
                    : "/_content/BasicSheets.Shared/icons/edit.svg")"
             class="vhdr-icon" />
    </button>
</div>

@* ── Bottom page slider (Seiten-Blättern) ───────────────────────────── *@
@if (!isEditMode && pageCount > 1 && !IsScrollMode)
{
    <div id="vbottom" class="vbottom @(showUi ? "" : "vbottom-hidden")">
        <input type="range" min="1" max="@pageCount"
               @bind="currentPage" @oninput="OnSlider"
               class="vbottom-range" style="--p:@(PagePercent)%" />
        <span class="vbottom-page">@currentPage<span class="vbottom-sep">/</span>@pageCount</span>
    </div>
}

@* ── Edit tool palette (floating + draggable) ───────────────────────── *@
@if (isEditMode)
{
    <div id="spanel" class="spanel @(panelCollapsed ? "spanel-collapsed" : "")"
         style="top:@(panelTop)px; left:@(panelLeft)px"
         @onclick:stopPropagation="true">

        @* Header = drag + tap-to-toggle: tippen klappt ein/aus, ziehen verschiebt *@
        <div id="spanel-drag" class="spanel-head"
             title="@(panelCollapsed ? "Antippen zum Ausklappen · ziehen zum Verschieben" : "Antippen zum Einklappen · ziehen zum Verschieben")">
            <span class="spanel-grip-bar"></span>
            <svg class="spanel-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 15 12 9 18 15"/>
            </svg>
        </div>

      @if (!panelCollapsed)
      {
        @* Tools (wrapping grid) *@
        <div class="sp-tools-strip">
            <button class="@ET("pen")" @onclick='()=>SetTool("pen")' title="Stift">
                <img src="/_content/BasicSheets.Shared/icons/pen.svg"
                     class="eticon @(activeTool=="pen"?"eticon-on":"")" />
            </button>
            <button class="@ET("marker")" @onclick='()=>SetTool("marker")' title="Marker">
                <img src="/_content/BasicSheets.Shared/icons/marker.svg"
                     class="eticon @(activeTool=="marker"?"eticon-on":"")" />
            </button>
            <button class="@ET("eraser")" @onclick='()=>SetTool("eraser")' title="Radierer">
                <img src="/_content/BasicSheets.Shared/icons/eraser.svg"
                     class="eticon @(activeTool=="eraser"?"eticon-on":"")" />
            </button>
            <button class="@ET("text")" @onclick='()=>SetTool("text")' title="Text">
                <span class="etsym">T</span>
            </button>
            <button class="@ET("move")" @onclick='()=>SetTool("move")' title="Verschieben">
                <img src="/_content/BasicSheets.Shared/icons/move.svg"
                     class="eticon @(activeTool=="move"?"eticon-on":"")" />
            </button>

            <span class="et-sep"></span>

            <button class="et-tool @(IsStampActive ? "et-tool-on" : "")" @onclick="OpenStampPicker" title="Stempel">
                <span class="etsym music sm @(CurrentStampIsDyn ? "etsym-dyn" : "")">@CurrentStampSym</span>
            </button>

            <span class="et-sep"></span>

            <button class="@ET("crescendo")" @onclick='()=>SetTool("crescendo")' title="Crescendo">
                <img src="/_content/BasicSheets.Shared/icons/crescendo.svg"
                     class="eticon @(activeTool=="crescendo"?"eticon-on":"")" />
            </button>
            <button class="@ET("decrescendo")" @onclick='()=>SetTool("decrescendo")' title="Decrescendo">
                <img src="/_content/BasicSheets.Shared/icons/decrescendo.svg"
                     class="eticon @(activeTool=="decrescendo"?"eticon-on":"")" />
            </button>
        </div>

        @* Options row *@
        <div class="sp-opts-row">
            <button class="et-color-btn" @onclick="OpenColorPicker">
                <span class="et-color-dot" style="background:@activeColor"></span>
            </button>

            @if (!IsNoSizeTool)
            {
                <input type="range" min="1" max="20" value="@ActiveSize"
                       class="et-range" @oninput="OnSizeSlider" />
                <span class="et-size-val">@ActiveSize</span>
            }

            <div class="et-flex"></div>

            <button class="et-act" @onclick="Undo" title="Rückgängig">
                <img src="/_content/BasicSheets.Shared/icons/undo.svg" class="eticon" />
            </button>
            <button class="et-act" @onclick="Redo" title="Wiederholen">
                <img src="/_content/BasicSheets.Shared/icons/redo.svg" class="eticon" />
            </button>
            <button class="et-act" @onclick="ClearPage" title="Seite leeren">
                <img src="/_content/BasicSheets.Shared/icons/delete.svg" class="eticon" />
            </button>
        </div>
      }
    </div>
}

@* ── Mode dropdown ────────────────────────────────────────────────── *@
@if (showModeDropdown)
{
    <div class="mdrop-bg" @onclick="CloseModeDropdown">
        <div class="mdrop-box" @onclick:stopPropagation="true">
            <div class="mdrop-hdr">
                <span class="mdrop-title">Seitenansicht</span>
                @if (sheetModeOverride != null)
                {
                    <span class="mdrop-sub">Dieses Stück</span>
                }
            </div>
            @foreach (var m in ModeOptions)
            {
                bool active = sheetModeOverride == m.Key;
                <button class="mdrop-item @(active ? "mdrop-item-on" : "")"
                        @onclick="() => SetSheetMode(m.Key)">
                    <span class="mdrop-sym">@m.Sym</span>
                    <div class="mdrop-info">
                        <span class="mdrop-lbl">@m.Label</span>
                        <span class="mdrop-desc">@m.Desc</span>
                    </div>
                    @if (active) { <span class="mdrop-check">✓</span> }
                </button>
            }
        </div>
    </div>
}

@* ── Color picker popup ───────────────────────────────────────────── *@
@if (showColorPicker)
{
    <div class="cpick-bg" @onclick="CloseColorPicker">
        <div class="cpick-box" @onclick:stopPropagation="true">

            <div class="cpick-hdr">
                <span class="cpick-title">Farbe</span>
                <button class="cpick-edit-toggle" @onclick="ToggleColorEditMode">
                    @(colorEditMode ? "Fertig" : "Bearbeiten")
                </button>
            </div>

            <div class="cpick-grid">
                @for (int i = 0; i < allColors.Count; i++)
                {
                    int idx = i;
                    var c   = allColors[i];
                    <button class="cpick-item @(activeColor==c[0] && !colorEditMode ? "cpick-item-on" : "")"
                            @onclick="() => OnColorItemClick(idx)">
                        <span class="cpick-dot" style="background:@c[0]">
                            @if (!colorEditMode && activeColor == c[0])
                            {
                                <span class="cpick-check">✓</span>
                            }
                            @if (colorEditMode)
                            {
                                <span class="cpick-pencil">✎</span>
                            }
                        </span>
                        <span class="cpick-nm">@(string.IsNullOrEmpty(c[1]) ? "—" : c[1])</span>
                    </button>
                }

                @if (colorEditMode)
                {
                    <button class="cpick-item cpick-add-item" @onclick="StartAddColor">
                        <span class="cpick-dot cpick-dot-add">+</span>
                        <span class="cpick-nm">Neu</span>
                    </button>
                }
            </div>

            @if (editColorIdx >= 0)
            {
                <div class="cpick-form">
                    <div class="cpick-form-row">
                        <input type="color" class="cpick-picker" @bind="editColorHex" @bind:event="oninput" />
                        <input type="text" class="field-input cpick-name-inp"
                               placeholder="Name (z.B. Wiederholung)"
                               @bind="editColorName" @bind:event="oninput" />
                    </div>
                    <div class="cpick-form-btns">
                        @if (editColorIdx < allColors.Count)
                        {
                            <button class="cpick-del-btn" @onclick="DeleteEditingColor">Löschen</button>
                        }
                        <button class="submit-btn cpick-save-btn" @onclick="SaveEditingColor">Speichern</button>
                    </div>
                </div>
            }

        </div>
    </div>
}

@* ── Stamp picker popup ───────────────────────────────────────────── *@
@if (showStampPicker)
{
    <div class="cpick-bg" @onclick="() => showStampPicker = false">
        <div class="cpick-box" @onclick:stopPropagation="true">
            <div class="cpick-hdr">
                <span class="cpick-title">Stempel</span>
            </div>
            <div class="stamp-grid">
                @foreach (var st in AllStamps)
                {
                    var s = st;
                    <button class="stamp-item @(activeTool == s.Key ? "stamp-item-on" : "")"
                            @onclick="async () => await PickStamp(s.Key)">
                        <span class="stamp-sym @(s.Key.StartsWith("dyn-") ? "stamp-dyn" : "")">@s.Sym</span>
                        <span class="stamp-nm">@s.Label</span>
                    </button>
                }
            </div>
        </div>
    </div>
}

@* ── Text-input overlay ───────────────────────────────────────────── *@
@if (showTextInput)
{
    <div class="vtxt-bg" @onclick="CancelText">
        <div class="vtxt-box"
             style="left:@(ClampX(textScreenX))px;top:@(ClampY(textScreenY))px"
             @onclick:stopPropagation="true">
            <input @bind="textValue" @bind:event="oninput"
                   placeholder="Text eingeben..."
                   @onkeydown="OnTextKey" autofocus />
            <button class="vtxt-ok" @onclick="ConfirmText">&#x2713;</button>
        </div>
    </div>
}

@* ── Bookmark dialog ──────────────────────────────────────────────── *@
@if (showBookmarkDialog)
{
    <div class="cpick-bg" @onclick="CancelBookmark">
        <div class="cpick-box" @onclick:stopPropagation="true" style="padding:1rem">
            <div class="cpick-hdr">
                <span class="cpick-title">Lesezeichen – Seite @currentPage</span>
                @if (existingBookmark != null)
                {
                    <button class="cpick-edit-toggle" style="color:var(--c-danger)" @onclick="RemoveBookmark">Entfernen</button>
                }
            </div>
            <div class="form-group" style="margin-top:0.75rem">
                <label class="field-label">Bezeichnung</label>
                <input class="field-input" placeholder="z.B. Verse 1, Chorus…"
                       @bind="bookmarkLabel" @bind:event="oninput" autofocus />
            </div>
            <div style="display:flex;gap:0.5rem;margin-top:0.75rem">
                @foreach (var col in new[]{"#4d8a80","#E53935","#FB8C00","#43A047","#1E88E5","#8E24AA"})
                {
                    var c = col;
                    <button style="width:2rem;height:2rem;border-radius:50%;background:@c;border:@(bookmarkColor==c?"3px solid white":"2px solid transparent");box-shadow:@(bookmarkColor==c?"0 0 0 2px var(--c-primary)":"none");cursor:pointer"
                            @onclick="() => bookmarkColor = c"></button>
                }
            </div>
            <button class="submit-btn" style="margin-top:0.85rem" @onclick="SaveBookmark">Speichern</button>
        </div>
    </div>
}

@* ── Quick panel (bottom drawer) ─────────────────────────────────── *@
@if (showQuickPanel)
{
    <div class="qp-bg" @onclick="() => showQuickPanel = false">
        <div class="qp-box" @onclick:stopPropagation="true">

            <div class="qp-tabs">
                <button class="qp-tab @(quickPanelTab==0?"qp-tab-on":"")" @onclick="() => quickPanelTab = 0">
                    Einstellungen
                </button>
                <button class="qp-tab @(quickPanelTab==1?"qp-tab-on":"")" @onclick="() => quickPanelTab = 1">
                    Lesezeichen
                </button>
            </div>

            @if (quickPanelTab == 0)
            {
                <div class="qp-body">
                    <div class="qp-row">
                        <span class="qp-label">Ansicht</span>
                        <div class="seg-group" style="flex:1">
                            @foreach (var m in ModeOptions.Where(m => m.Key != null))
                            {
                                var mk = m;
                                <button class="seg-btn @(sheetModeOverride==mk.Key?"seg-btn-on":"")"
                                        @onclick="async () => await SetSheetMode(mk.Key)"
                                        title="@mk.Label">
                                    @mk.Sym
                                </button>
                            }
                        </div>
                    </div>

                    <div class="qp-row">
                        <span class="qp-label">Hintergrund</span>
                        <div class="seg-group">
                            <button class="seg-btn @(viewerBg=="dark"?"seg-btn-on":"")"  @onclick='()=>SetViewerBg("dark")'> Dunkel</button>
                            <button class="seg-btn @(viewerBg=="gray"?"seg-btn-on":"")"  @onclick='()=>SetViewerBg("gray")'> Grau</button>
                            <button class="seg-btn @(viewerBg=="white"?"seg-btn-on":"")" @onclick='()=>SetViewerBg("white")'>Hell</button>
                        </div>
                    </div>

                    @{
                        var autoTurnSetting = SettingsService.GetSettings().FirstOrDefault(s => s.Name == "Seiten automatisch umblättern");
                    }
                    @if (autoTurnSetting != null)
                    {
                        <div class="qp-row">
                            <span class="qp-label">Auto-Blättern</span>
                            <div class="seg-group">
                                @foreach (var opt in autoTurnSetting.Options ?? new())
                                {
                                    var parts = opt.Split('|', 2);
                                    var v = parts[0]; var l = parts.Length > 1 ? parts[1] : v;
                                    var cv = v;
                                    <button class="seg-btn @(autoTurnSetting.Value==cv?"seg-btn-on":"")"
                                            @onclick="() => { autoTurnSetting.Value = cv; SettingsService.SaveSettings(); StopAutoPageTurn(); StartAutoPageTurn(); }">
                                        @l
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @{
                        var screenOnSetting = SettingsService.GetSettings().FirstOrDefault(s => s.Name == "Bildschirm wach halten");
                    }
                    @if (screenOnSetting != null)
                    {
                        var son = screenOnSetting;
                        <div class="qp-row">
                            <span class="qp-label">Bildschirm</span>
                            <label class="switch">
                                <input type="checkbox" checked="@(son.Value=="true")"
                                       @onclick="() => ToggleScreenOn(son)" />
                                <span class="slider"></span>
                            </label>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="qp-body">
                    @{
                        var pdfBookmarks = BookmarkService.GetForFile(file ?? "");
                    }
                    @if (pdfBookmarks.Count == 0)
                    {
                        <div class="empty-state" style="padding:1.5rem 0">
                            <p class="empty-title" style="font-size:0.85rem">Keine Lesezeichen</p>
                            <p class="empty-sub">Lang drücken um ein Lesezeichen zu setzen</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var bm in pdfBookmarks)
                        {
                            <div class="qp-bm-item" @onclick="async () => await JumpToBookmark(bm)">
                                <div class="bookmark-dot" style="background:@bm.Color"></div>
                                <div style="flex:1;min-width:0">
                                    <div class="qp-bm-title">@(string.IsNullOrEmpty(bm.Label) ? $"Seite {bm.Page}" : bm.Label)</div>
                                    <div class="qp-bm-sub">Seite @bm.Page</div>
                                </div>
                                <button class="vbtn-del" @onclick:stopPropagation="true" @onclick="() => { BookmarkService.Remove(bm.Id); RefreshPageBookmark(); StateHasChanged(); }" title="Löschen">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
                                </button>
                            </div>
                        }
                    }
                    <button class="add-btn" style="margin-top:0.5rem"
                            @onclick="() => { showQuickPanel = false; OpenBookmarkDialog(); }">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        Lesezeichen hinzufügen
                    </button>
                </div>
            }

        </div>
    </div>
}

@code {
    [Parameter] public string? file { get; set; }

    // ── Viewer state ────────────────────────────────────────────────────
    private int  currentPage = 1, pageCount = 1, totalPages = 1;
    private bool showUi = true, showStart, showEnd, showError;
    private string errorMessage = "";
    private bool isEditMode, enableHandleClick = true;
    private string viewerBg = "dark";

    // ── Quick panel ─────────────────────────────────────────────────────
    private bool showQuickPanel = false;
    private int  quickPanelTab  = 0;

    // ── Tools ────────────────────────────────────────────────────────────
    private string activeTool  = "pen";
    private string activeColor = "#000000";
    private string activeStamp = "flat";   // last-picked stamp (shown on the stamp button)

    private Dictionary<string, int>    toolSizes  = new();
    private Dictionary<string, string> toolColors = new();
    private static readonly Dictionary<string, int> ToolDefaultSizes = new()
    {
        ["pen"]         = 4,
        ["marker"]      = 7,
        ["eraser"]      = 8,
        ["text"]        = 5,
        ["crescendo"]   = 4,
        ["decrescendo"] = 4,
    };
    private int ActiveSize => toolSizes.TryGetValue(activeTool, out var s) ? s : ToolDefaultSizes.GetValueOrDefault(activeTool, 5);

    // ── Text overlay ─────────────────────────────────────────────────────
    private bool   showTextInput;
    private double textCanvasX, textCanvasY, textScreenX, textScreenY;
    private string textValue = "";

    // ── Color system ─────────────────────────────────────────────────────
    private List<string[]> allColors = new();
    private bool showColorPicker  = false;
    private bool showStampPicker  = false;
    private bool colorEditMode    = false;
    private int  editColorIdx     = -1;
    private string editColorHex  = "#FF6B35";
    private string editColorName = "";

    private static readonly List<string[]> DefaultColors =
    [
        ["#000000", "Schwarz"],
        ["#E53935", "Rot"],
        ["#1E88E5", "Blau"],
        ["#43A047", "Grün"],
        ["#FB8C00", "Orange"],
        ["#8E24AA", "Lila"],
    ];

    // ── Page mode ────────────────────────────────────────────────────────
    private Sheet?  currentSheet      = null;
    private string? sheetModeOverride = null;
    private string  effectiveMode     = "single";
    private bool    showModeDropdown  = false;
    private record ModeOption(string? Key, string Label, string Sym, string Desc);
    private static readonly ModeOption[] ModeOptions =
    [
        new(null,         "Standard",             "·",  "Verwendet die globale Einstellung"),
        new("single",     "Einzelne Seite",       "1",  "Eine Seite gleichzeitig anzeigen"),
        new("two",        "Zwei Seiten",          "II", "Zwei Seiten nebeneinander"),
        new("half-turn",  "Halbe Seite",          "½",  "Ganze Seite, blättert zur Hälfte"),
        new("scroll-v",   "Vertikal scrollen",    "↕",  "Alle Seiten untereinander – durchscrollen"),
    ];

    // ── Auto page turn ───────────────────────────────────────────────────
