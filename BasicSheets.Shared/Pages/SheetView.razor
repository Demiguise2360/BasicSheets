    private bool _preferFlats = false; // chord spelling preference (♯ vs ♭)

    private async Task LoadTextSongAsync()
    {
        try
        {
            var textPath = Path.Combine(SheetService.UploadFolder, file!);
            if (!File.Exists(textPath))
            {
                ShowErrorMessage($"Die Datei «{file}» wurde nicht gefunden. Möglicherweise wurde sie gelöscht.");
                return;
            }

            var raw = await File.ReadAllTextAsync(textPath);
            _song = ChordPro.Parse(raw, Path.GetExtension(file));
            pageCount = 1; currentPage = 1;

            if (currentSheet != null)
                _transpose = Math.Clamp(currentSheet.Transpose, -11, 11);

            if (SettingsService.KeepScreenOn())
                _ = JS.InvokeVoidAsync("setWakeLock", true);

            StateHasChanged();
            StartAutoHide();
        }
        catch (Exception ex)
        {
            ShowErrorMessage($"Textdatei konnte nicht geladen werden: {ex.Message}");
        }
    }

    private string DisplayChord(string chord) =>
        _transpose == 0 ? chord : ChordTransposer.Transpose(chord, _transpose, _preferFlats);

    private string TransposeLabel
    {
        get
        {
            var key = string.IsNullOrWhiteSpace(_song?.Key)
                ? "" : ChordTransposer.Transpose(_song!.Key, _transpose, _preferFlats);
            var steps = _transpose > 0 ? $"+{_transpose}" : _transpose.ToString();
            if (!string.IsNullOrEmpty(key)) return _transpose == 0 ? key : $"{key} {steps}";
            return _transpose == 0 ? "±0" : steps;
        }
    }

    private void TransposeDown() => SetTranspose(_transpose - 1);
    private void TransposeUp()   => SetTranspose(_transpose + 1);
    private void SetTranspose(int v)
    {
        _transpose = Math.Clamp(v, -11, 11);
        if (currentSheet != null)
        {
            currentSheet.Transpose = _transpose;
            try { SheetService.UpdateSheet(currentSheet); } catch { }
        }
        ResetAutoHide();
        StateHasChanged();
    }

    private void ToggleAccidental() { _preferFlats = !_preferFlats; ResetAutoHide(); StateHasChanged(); }

    private void FontDown() => SetFont(_textFontPx - 1);
    private void FontUp()   => SetFont(_textFontPx + 1);
    private void SetFont(int px) { _textFontPx = Math.Clamp(px, 10, 40); ResetAutoHide(); StateHasChanged(); }

