    private void OnColorItemClick(int idx)
    {
        if (idx < 0 || idx >= allColors.Count) return;
        if (colorEditMode) { EditColor(idx); return; }
        SetColor(allColors[idx][0]);
        showColorPicker = false;
    }
    private void EditColor(int idx)
    {
        if (idx < 0 || idx >= allColors.Count) return;
        editColorIdx = idx; editColorHex = allColors[idx][0]; editColorName = allColors[idx][1];
    }
    private void StartAddColor() { editColorIdx = allColors.Count; editColorHex = "#FF6B35"; editColorName = ""; }
    private async Task DeleteEditingColor()
    {
        if (editColorIdx >= 0 && editColorIdx < allColors.Count)
        {
            if (activeColor == allColors[editColorIdx][0] && allColors.Count > 1)
                SetColor(allColors[0][0]);
            allColors.RemoveAt(editColorIdx);
            await SaveColorsAsync();
        }
        editColorIdx = -1;
    }
    private async Task SaveEditingColor()
    {
        if (string.IsNullOrWhiteSpace(editColorHex)) return;
        var entry = new string[] { editColorHex, (editColorName ?? "").Trim() };
        if (editColorIdx == allColors.Count) allColors.Add(entry);
        else if (editColorIdx >= 0 && editColorIdx < allColors.Count) allColors[editColorIdx] = entry;
        await SaveColorsAsync();
        editColorIdx = -1;
    }

    // ── Color persistence ─────────────────────────────────────────────────
    private async Task LoadColorsAsync()
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("loadColors");
            if (!string.IsNullOrEmpty(raw))
            {
                var loaded = JsonSerializer.Deserialize<List<string[]>>(raw);
                if (loaded != null && loaded.Count > 0) { allColors = loaded; return; }
            }
        }
        catch { }

        try
        {
            var oldRaw = await JS.InvokeAsync<string?>("loadLegacyUserColors");
            var userPart = new List<string[]>();
            if (!string.IsNullOrEmpty(oldRaw))
                userPart = JsonSerializer.Deserialize<List<string[]>>(oldRaw) ?? new();

            allColors = DefaultColors.Select(c => (string[])c.Clone()).ToList();
            foreach (var u in userPart)
                if (!allColors.Any(d => d[0] == u[0]))
                    allColors.Add(u);
            await SaveColorsAsync();
        }
        catch
        {
            allColors = DefaultColors.Select(c => (string[])c.Clone()).ToList();
        }
    }

    private async Task SaveColorsAsync()
    {
        try { await JS.InvokeVoidAsync("saveColors", JsonSerializer.Serialize(allColors)); }
        catch (Exception ex) { Console.WriteLine($"[SheetView] Farben konnten nicht gespeichert werden: {ex.Message}"); }
    }

