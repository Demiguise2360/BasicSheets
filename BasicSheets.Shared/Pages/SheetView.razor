    private async Task SaveLink()
    {
        if (string.IsNullOrEmpty(file)) { _showLinkDialog = false; return; }
        _linkTargetPage = Math.Clamp(_linkTargetPage, 1, pageCount);
        var label = (_linkLabel ?? "").Trim();
        if (label.Length > 8) label = label[..8];

        if (_linkEditId != null)
        {
            var ex = _linkPoints.FirstOrDefault(b => b.Id == _linkEditId);
            if (ex != null) { ex.TargetPage = _linkTargetPage; ex.Label = label; ViewerButtonService.Update(ex); }
        }
        else
        {
            ViewerButtonService.Add(new ViewerButton
            {
                PdfFile    = file,
                SourcePage = currentPage,
                SourceNX   = _linkNX,
                SourceNY   = _linkNY,
                TargetPage = _linkTargetPage,
                TargetNX   = -1,
                TargetNY   = -1,
                Label      = label,
                Color      = "#387373",
                Action     = "jump",
            });
        }

        _linkPoints     = ViewerButtonService.GetForFile(file);
        _showLinkDialog = false;
        _linkEditId     = null;
        await PushPageButtons();
        StateHasChanged();
    }

    private void CancelLink()
    {
        _showLinkDialog = false;
        _linkEditId     = null;
        StateHasChanged();
    }

