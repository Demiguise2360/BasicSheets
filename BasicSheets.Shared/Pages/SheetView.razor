    private async Task AutoCrop()
    {
        if (_isText || effectiveMode != "single") return;
        int pdfPage = _isImage ? 1 : currentPage + _pageOffset;
        try
        {
            var rect = await JS.InvokeAsync<double[]?>("autoDetectCrop");
            if (rect == null || rect.Length < 4) return;
            await JS.InvokeVoidAsync("setCrop", rect[0], rect[1], rect[2], rect[3]);
            await JS.InvokeVoidAsync("refit");
            if (currentSheet != null)
            {
                CropService.SetCrop(currentSheet.Id, pdfPage, rect[0], rect[1], rect[2], rect[3]);
                _crops[pdfPage] = new Crop { SheetId = currentSheet.Id, Page = pdfPage, L = rect[0], T = rect[1], R = rect[2], B = rect[3] };
            }
        }
        catch (Exception ex) { Console.WriteLine($"[SheetView] Auto-Crop fehlgeschlagen: {ex.Message}"); }
        if (!_hasRange && pdfPage == 1) await RegenThumb();
        StateHasChanged();
    }

    private async Task ResetCrop()
    {
        if (_isText) return;
        int pdfPage = _isImage ? 1 : currentPage + _pageOffset;
        try
        {
            await JS.InvokeVoidAsync("clearCrop");
            await JS.InvokeVoidAsync("refit");
        }
        catch { }
        if (currentSheet != null) { CropService.RemoveCrop(currentSheet.Id, pdfPage); _crops.Remove(pdfPage); }
        if (!_hasRange && pdfPage == 1) await RegenThumb();
        StateHasChanged();
    }

    // ── Reset all crops + crop-aware thumbnail ─────────────────────────────
    private async Task ResetAllCrops()
    {
        if (_isText) return;
        if (currentSheet != null) { CropService.RemoveAll(currentSheet.Id); _crops.Clear(); }
        try { await JS.InvokeVoidAsync("clearCrop"); await JS.InvokeVoidAsync("refit"); } catch { }
        if (!_hasRange) await RegenThumb();
        StateHasChanged();
    }

    private async Task<string?> RenderThumbAsync()
    {
        var c1 = (!_hasRange) ? _crops.GetValueOrDefault(1) : null;
        return c1 != null
            ? await JS.InvokeAsync<string?>("renderThumbnail", 180, c1.L, c1.T, c1.R, c1.B)
            : await JS.InvokeAsync<string?>("renderThumbnail", 180);
    }

    private async Task RegenThumb()
    {
        if (string.IsNullOrEmpty(file) || _isText) return;
        try
        {
            var thumb = await RenderThumbAsync();
            if (!string.IsNullOrEmpty(thumb)) ThumbnailService.Set(file, thumb);
        }
        catch { }
    }

    // ── Rotation (per song, display only) ──────────────────────────────────
    private int _rotation;

    private async Task RotatePage()
    {
        if (_isText) return;
        _rotation = (_rotation + 90) % 360;
        if (currentSheet != null)
        {
            currentSheet.Rotation = _rotation;
            try { SheetService.UpdateSheet(currentSheet); } catch { }
        }
        try { await JS.InvokeVoidAsync("setRotation", _rotation); } catch { }
        await RenderCurrent();
        if (!_hasRange) _ = RegenThumb();
        StateHasChanged();
    }

    // ── Batch auto-crop (all pages) ────────────────────────────────────────
    private bool _batchBusy;
    private string? _batchNotice;

    private async Task BatchAutoCrop()
    {
        if (_isText || _isImage || _batchBusy) return;
        _batchBusy = true; StateHasChanged();
        try
        {
            var all = await JS.InvokeAsync<double[][]?>("autoDetectCropAll");
            if (all != null)
            {
                var list = new List<(int, double, double, double, double)>();
                for (int i = 0; i < all.Length; i++)
                {
                    var r = all[i];
                    if (r != null && r.Length >= 4)
                    {
                        int page = i + 1;
                        list.Add((page, r[0], r[1], r[2], r[3]));
                        _crops[page] = new Crop { SheetId = currentSheet?.Id ?? 0, Page = page, L = r[0], T = r[1], R = r[2], B = r[3] };
                    }
                }
                if (currentSheet != null && list.Count > 0)
                    CropService.SetMany(currentSheet.Id, list);
                _batchNotice = $"{list.Count} von {all.Length} Seiten zugeschnitten";
                await RenderCurrent();
            }
        }
        catch (Exception ex) { Console.WriteLine($"[SheetView] Batch-Crop fehlgeschlagen: {ex.Message}"); }

        if (!_hasRange) await RegenThumb();
        _batchBusy = false;
        showQuickPanel = false;
        StateHasChanged();

        if (_batchNotice != null)
        {
            var token = _batchNotice;
            _ = Task.Run(async () =>
            {
                await Task.Delay(2200);
                await InvokeAsync(() => { if (_batchNotice == token) { _batchNotice = null; StateHasChanged(); } });
            });
        }
    }

    // ── Manual crop editor ─────────────────────────────────────────────────
    private bool   _cropEditMode;
    private double _pageX, _pageY, _pageW, _pageH;     // page's on-screen rect while editing
    private double _edL, _edT, _edR = 1, _edB = 1;     // crop being edited (fractions)
    private string? _edDrag;                           // active handle, or null
    private double _edStartFx, _edStartFy;
    private (double L, double T, double R, double B) _edStartRect;
    private int _edPage = 1;

    private double RxVal => _pageX + _edL * _pageW;
    private double RyVal => _pageY + _edT * _pageH;
    private double RwVal => (_edR - _edL) * _pageW;
    private double RhVal => (_edB - _edT) * _pageH;
    private static string Px(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "px";

    private async Task EnterCropEdit()
    {
        if (_isText || effectiveMode != "single") return;
        _edPage = _isImage ? 1 : currentPage + _pageOffset;
        showQuickPanel = false;
        try
        {
            var r = await JS.InvokeAsync<double[]>("beginCropEdit");
            if (r == null || r.Length < 4) return;
            _pageX = r[0]; _pageY = r[1]; _pageW = r[2]; _pageH = r[3];
        }
        catch (Exception ex) { Console.WriteLine($"[SheetView] Crop-Editor konnte nicht gestartet werden: {ex.Message}"); return; }

        var existing = _crops.GetValueOrDefault(_edPage);
        if (existing != null) { _edL = existing.L; _edT = existing.T; _edR = existing.R; _edB = existing.B; }
        else { _edL = 0.06; _edT = 0.06; _edR = 0.94; _edB = 0.94; }

        _cropEditMode = true;
        StateHasChanged();
    }

    private double PointerFx(double clientX) => _pageW <= 0 ? 0 : Math.Clamp((clientX - _pageX) / _pageW, 0, 1);
    private double PointerFy(double clientY) => _pageH <= 0 ? 0 : Math.Clamp((clientY - _pageY) / _pageH, 0, 1);

    private void StartCropDrag(PointerEventArgs e, string handle)
    {
        _edDrag      = handle;
        _edStartRect = (_edL, _edT, _edR, _edB);
        _edStartFx   = PointerFx(e.ClientX);
        _edStartFy   = PointerFy(e.ClientY);
    }

    private void CropDragMove(PointerEventArgs e)
    {
        if (_edDrag == null) return;
        var (l, t, r, b) = CropEditMath.Apply(_edDrag, _edStartRect, _edStartFx, _edStartFy,
                                              PointerFx(e.ClientX), PointerFy(e.ClientY));
        _edL = l; _edT = t; _edR = r; _edB = b;
        StateHasChanged();
    }

    private void CropDragEnd(PointerEventArgs e) => _edDrag = null;

    private async Task CropEditAuto()
    {
        try
        {
            var rect = await JS.InvokeAsync<double[]?>("autoDetectCrop");
            if (rect != null && rect.Length >= 4)
            {
                _edL = rect[0]; _edT = rect[1]; _edR = rect[2]; _edB = rect[3];
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task SaveCropEdit()
    {
        double l = Math.Min(_edL, _edR), r = Math.Max(_edL, _edR);
        double t = Math.Min(_edT, _edB), b = Math.Max(_edT, _edB);
        bool full = l <= 0.002 && t <= 0.002 && r >= 0.998 && b >= 0.998;

        _cropEditMode = false; _edDrag = null;
        try { await JS.InvokeVoidAsync("endCropEdit"); } catch { }

        if (currentSheet != null)
        {
            if (full) { CropService.RemoveCrop(currentSheet.Id, _edPage); _crops.Remove(_edPage); }
            else
            {
                CropService.SetCrop(currentSheet.Id, _edPage, l, t, r, b);
                _crops[_edPage] = new Crop { SheetId = currentSheet.Id, Page = _edPage, L = l, T = t, R = r, B = b };
            }
        }

        try
        {
            if (full) await JS.InvokeVoidAsync("clearCrop");
            else      await JS.InvokeVoidAsync("setCrop", l, t, r, b);
            await JS.InvokeVoidAsync("refit");
        }
        catch { }
        if (!_hasRange && _edPage == 1) await RegenThumb();
        StateHasChanged();
    }

    private async Task CancelCropEdit()
    {
        _cropEditMode = false; _edDrag = null;
        try { await JS.InvokeVoidAsync("endCropEdit"); } catch { }
        var prev = _crops.GetValueOrDefault(_edPage);
        try
        {
            if (prev != null) await JS.InvokeVoidAsync("setCrop", prev.L, prev.T, prev.R, prev.B);
            else              await JS.InvokeVoidAsync("clearCrop");
            await JS.InvokeVoidAsync("refit");
        }
        catch { }
        StateHasChanged();
    }

    private int? ParseQueryInt(string key)
    {
        try
        {
            var q = new Uri(Nav.Uri).Query.TrimStart('?');
            foreach (var part in q.Split('&', StringSplitOptions.RemoveEmptyEntries))
            {
                var kv = part.Split('=', 2);
                if (kv.Length == 2 && kv[0] == key && int.TryParse(kv[1], out var v)) return v;
            }
        }
        catch { }
        return null;
    }

    private void OnFileSwitch(ChangeEventArgs e)
    {
        var sel = e.Value?.ToString();
        if (string.IsNullOrEmpty(sel) || sel == file) return;
        var url = $"/sheets/{sel}";
        if (InSetlist) url += $"?setlist={_setlistId}";
        Nav.NavigateTo(url, forceLoad: true);
    }

    // ── Init ─────────────────────────────────────────────────────────────
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first)
        {
            if (_needPanelClamp)
            {
                _needPanelClamp = false;
                try { await JS.InvokeVoidAsync("clampPanelIntoView"); } catch { }
            }
            if (_focusPageInput)
            {
                _focusPageInput = false;
                try { await _pageInputRef.FocusAsync(); } catch { }
            }
            bool topVis = showUi || isEditMode;
            bool botVis = showUi && !isEditMode && pageCount > 1 && !IsScrollMode;
            if (!_chromeInit || topVis != _lastTopVis || botVis != _lastBotVis)
            {
                _chromeInit = true; _lastTopVis = topVis; _lastBotVis = botVis;
                try { await JS.InvokeVoidAsync("updateChromeInsets", topVis, botVis); } catch { }
            }
            return;
        }

        if (string.IsNullOrEmpty(file))
        {
            ShowErrorMessage("Keine Datei angegeben.");
            return;
        }

        _ref = DotNetObjectReference.Create(this);
        _shareService = Services.GetService(typeof(IShareService)) as IShareService;   // MAUI only; null on web
        viewerBg = SettingsService.GetViewerBackground();
        _invert  = SettingsService.InvertColors();
        _warm    = SettingsService.WarmReading();

        await LoadColorsAsync();
        await LoadToolStatesAsync();

        var reqSheetId    = ParseQueryInt("sheet");
        currentSheet      = (reqSheetId.HasValue ? SheetService.GetById(reqSheetId.Value) : null)
                            ?? SheetFileService.FindSheetByFile(file)
                            ?? SheetService.GetSheets().FirstOrDefault(s => Path.GetFileName(s.FilePath) == file);
        _hasRange         = currentSheet?.HasRange ?? false;
        sheetModeOverride = currentSheet?.PageMode;
        if (sheetModeOverride is "half" or "auto")
            sheetModeOverride = null;
        effectiveMode     = sheetModeOverride ?? SettingsService.GetPageMode();
        if (_hasRange) effectiveMode = "single";

        if (currentSheet != null)
            _songFiles = SheetFileService.GetSongFiles(currentSheet);

        if (!string.IsNullOrEmpty(file))
            _ = JS.InvokeVoidAsync("pushRecent", file);   // track for the "Zuletzt" library tab

        try { await JS.InvokeVoidAsync("setPdfDotNetRef", _ref); } catch { }   // audio callbacks reach us (text path too)
        try { await JS.InvokeVoidAsync("initKeyNav"); } catch { }              // keyboard / pedal nav (all song types)
        await LoadAudioAsync();

        // ChordPro / text songs render as HTML (no canvas) — skip the whole pdf.js path.
        _isText = ChordPro.IsTextFile(file);
        if (_isText)
        {
            await LoadTextSongAsync();
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("setPdfDotNetRef", _ref);
            try { _autoScrollSpeed = (int)Math.Round(await JS.InvokeAsync<double>("getAutoScrollSpeed")); } catch { }
            if (currentSheet != null && currentSheet.ScrollSpeed > 0)                 // per-song speed overrides the global default
                _autoScrollSpeed = Math.Clamp(currentSheet.ScrollSpeed, 4, 300);
            await JS.InvokeVoidAsync("initCanvas", "pdfCanvas", "markerCanvas", "noteCanvas");
            try { await JS.InvokeVoidAsync("initBtnCanvas", "btnCanvas"); } catch { }   // link-point marker overlay
        }
        catch (Exception ex)
        {
            ShowErrorMessage($"Canvas konnte nicht initialisiert werden: {ex.Message}");
            return;
        }

        try
        {
            var gestureConfig = new Dictionary<string, string>
            {
                ["swipe_bottom_up"] = SettingsService.GetGestureAction("Geste: Von unten wischen"),
                ["longpress"]       = SettingsService.GetGestureAction("Geste: Lang halten"),
                ["2finger_dbltap"]  = SettingsService.GetGestureAction("Geste: 2 Finger Doppeltippen"),
                ["3finger_left"]    = SettingsService.GetGestureAction("Geste: 3 Finger links"),
                ["3finger_right"]   = SettingsService.GetGestureAction("Geste: 3 Finger rechts"),
            };
            await JS.InvokeVoidAsync("initGestures", gestureConfig);
            await JS.InvokeVoidAsync("initStylusDetection");
            await JS.InvokeVoidAsync("setStylusAutoEdit", SettingsService.StylusAutoEdit());
            await JS.InvokeVoidAsync("setStylusButtonMode", SettingsService.StylusButtonMode());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SheetView] Gesten konnten nicht geladen werden: {ex.Message}");
        }

        try
        {
            panelTop       = (int)Math.Round(await JS.InvokeAsync<double>("loadPanelTop"));
            panelLeft      = (int)Math.Round(await JS.InvokeAsync<double>("loadPanelLeft"));
            panelCollapsed = await JS.InvokeAsync<bool>("loadPanelCollapsed");
            await JS.InvokeVoidAsync("initPanelDrag", _ref);
            await JS.InvokeVoidAsync("initFabDrag", _ref);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SheetView] Werkzeug-Palette konnte nicht initialisiert werden: {ex.Message}");
        }

        try
        {
            var filePath = Path.Combine(SheetService.UploadFolder, file);
            if (!File.Exists(filePath))
            {
                ShowErrorMessage($"Die Datei «{file}» wurde nicht gefunden. Möglicherweise wurde sie gelöscht.");
                return;
            }

            var pdfBytes = await File.ReadAllBytesAsync(filePath);
            if (pdfBytes.Length == 0)
            {
                ShowErrorMessage("Die PDF-Datei ist leer und kann nicht geöffnet werden.");
                return;
            }

            _isImage = IsImageFile(file);
            if (_isImage) effectiveMode = "single";
            totalPages = _isImage
                ? await JS.InvokeAsync<int>("loadImageData", file, pdfBytes)
                : await JS.InvokeAsync<int>("loadPdfData", file, pdfBytes);
            if (totalPages <= 0)
            {
                ShowErrorMessage("Die PDF-Datei konnte nicht gelesen werden. Ist sie beschädigt?");
                return;
            }

            if (currentSheet != null) _rotation = ((currentSheet.Rotation % 360) + 360) % 360;
            if (currentSheet != null)
            {
                if (currentSheet.Bpm   > 0) _metroBpm   = Math.Clamp(currentSheet.Bpm, 20, 300);
                if (currentSheet.Beats > 0) _metroBeats = Math.Clamp(currentSheet.Beats, 1, 16);
            }
            try { await JS.InvokeVoidAsync("setRotation", _rotation); } catch { }

            if (currentSheet != null && !_isImage && !_hasRange)
                _pageOrder = PageOrderUtil.Parse(currentSheet.PageOrder, totalPages);

            RecalcPageCount();

            if (currentSheet != null) _crops = CropService.GetCrops(currentSheet.Id);
            _linkPoints = ViewerButtonService.GetForFile(file ?? "");
            _smartButtons = ViewerButtonService.GetFloating();   // global quick-jump buttons
            _pageThumbs.Clear();   // thumbnails are keyed by PDF page; a new song is a different PDF
            _backStack.Clear();
            _showMatchNav = false; _searchIdx = -1; _searchResults = new();

            // Generate a first-page thumbnail once (cached), reusing the loaded pdfDoc.
            try
            {
                if (!ThumbnailService.Has(file))
                {
                    var thumb = await RenderThumbAsync();
                    if (!string.IsNullOrEmpty(thumb))
                        ThumbnailService.Set(file, thumb);
                }
            }
            catch (Exception ex) { Console.WriteLine($"[SheetView] Thumbnail fehlgeschlagen: {ex.Message}"); }

            if (SettingsService.RememberLastPage())
            {
                try
                {
                    var lastPage = await JS.InvokeAsync<int>("loadLastPage", file);
                    if (lastPage > 1 && lastPage <= pageCount)
                        currentPage = lastPage;
                }
                catch { /* last page not critical */ }
            }

            try
            {
                var uri   = new Uri(Nav.Uri);
                var query = uri.Query.TrimStart('?');
                string? atParam = null;
                foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
                {
                    var kv = part.Split('=', 2);
                    if (kv.Length != 2) continue;
                    if (kv[0] == "page" && int.TryParse(kv[1], out var qPage))
                    {
                        if (qPage >= 1 && qPage <= pageCount) currentPage = qPage;
                    }
                    else if (kv[0] == "setlist" && int.TryParse(kv[1], out var slId))
                    {
                        _setlistId = slId;
                    }
                    else if (kv[0] == "at")
                    {
                        atParam = kv[1];
                    }
                }

                if (_setlistId.HasValue)
                {
                    var slSheets  = SetlistService.GetSheets(_setlistId.Value);
                    _setlistFiles = slSheets.Select(s => Path.GetFileName(s.FilePath)).ToList();
                    _setlistNames = slSheets.Select(s => s.Name).ToList();
                    _setlistIndex = _setlistFiles.FindIndex(f => f == file);
                }

                if (atParam == "last" && pageCount > 0)
                    currentPage = pageCount;
            }
            catch { /* query param parsing not critical */ }

            RefreshPageBookmark();
            await RenderCurrent();
            StateHasChanged();
            await RefreshDocHasNotes();   // show the hide/show-annotations toggle if this doc has any

            if (SettingsService.KeepScreenOn())
                _ = JS.InvokeVoidAsync("setWakeLock", true);

            var animSetting = SettingsService.GetSettings().FirstOrDefault(s => s.Name == "Seitenübergang animieren");
            _ = JS.InvokeVoidAsync("setAnimateTransitions", animSetting?.Value == "true");

            StartAutoPageTurn();
            StartAutoHide();
        }
        catch (JSException ex)
        {
            ShowErrorMessage($"PDF-Viewer Fehler: {ex.Message}");
        }
        catch (IOException ex)
        {
            ShowErrorMessage($"Datei konnte nicht gelesen werden: {ex.Message}");
        }
        catch (Exception ex)
        {
            ShowErrorMessage($"Fehler beim Laden: {ex.Message}");
        }
    }

    private void ShowErrorMessage(string msg)
    {
        showError = true;
        errorMessage = msg;
        StateHasChanged();
    }

    private void RecalcPageCount()
    {
        if (_isImage) { pageCount = 1; _pageOffset = 0; return; }
        if (_hasRange && currentSheet != null)
        {
            int start = Math.Clamp(currentSheet.PageStart, 1, Math.Max(1, totalPages));
            int end   = Math.Clamp(currentSheet.PageEnd, start, Math.Max(1, totalPages));
            _pageOffset = start - 1;
            pageCount = end - start + 1;
            return;
        }
        if (HasPageOrder && effectiveMode == "single")
        {
            _pageOffset = 0;
            pageCount = _pageOrder.Count;
            return;
        }
        if (HasPageOrder && effectiveMode == "half-turn")
        {
            _pageOffset = 0;
            pageCount = _pageOrder.Count * 2;   // two halves per display slot
            return;
        }
        if (HasPageOrder && effectiveMode == "two")
        {
            _pageOffset = 0;
            pageCount = Math.Max(1, _pageOrder.Count - 1);   // overlapping pairs across the sequence
            return;
        }
        _pageOffset = 0;
        pageCount = effectiveMode switch
        {
            "two"       => Math.Max(1, totalPages - 1),
            "half-turn" => totalPages * 2,
            "scroll-v"  => 1,
            "scroll-h"  => 1,
            _           => totalPages
        };
    }

    // ── Auto page turn ────────────────────────────────────────────────────
    private void StartAutoPageTurn()
    {
        StopAutoPageTurn();
        var secs = SettingsService.AutoPageTurnSeconds();
        if (secs <= 0 || IsScrollMode || isEditMode) return;
        _autoTurnCts = new System.Threading.CancellationTokenSource();
        var token = _autoTurnCts.Token;
        Task.Run(async () =>
        {
            while (!token.IsCancellationRequested)
            {
                try { await Task.Delay(secs * 1000, token); }
                catch (OperationCanceledException) { break; }
                if (token.IsCancellationRequested) break;
                if (currentPage < pageCount)
                {
                    try
                    {
                        await InvokeAsync(async () =>
                        {
                            currentPage++;
                            await RenderCurrent();
                            if (SettingsService.RememberLastPage())
                                _ = JS.InvokeVoidAsync("saveLastPage", file, currentPage);
                            StateHasChanged();
                        });
                    }
                    catch { break; }
                }
                else { break; }
            }
        }, token);
    }

    private void StopAutoPageTurn()
    {
        try { _autoTurnCts?.Cancel(); } catch { }
        _autoTurnCts = null;
    }

    // ── Auto-scroll (smooth continuous scroll) ─────────────────────────────
    private async Task ToggleAutoScroll()
    {
        if (_autoScrolling)
        {
            await HaltAutoScroll();
        }
        else
        {
            if (!CanAutoScroll) return;
            StopAutoPageTurn();                 // the two auto-advance modes don't run together
            _autoScrolling = true;
            try { await JS.InvokeVoidAsync("startAutoScroll", _autoScrollSpeed); }
            catch { _autoScrolling = false; }
        }
        StateHasChanged();
    }

    private async Task SetAutoScrollSpeed(int px)
    {
        _autoScrollSpeed = Math.Clamp(px, 4, 300);
        try { await JS.InvokeVoidAsync("setAutoScrollSpeed", _autoScrollSpeed); } catch { }
        PersistScrollSpeed();
        StateHasChanged();
    }

    // Remember this song's auto-scroll speed so it reopens at the same pace (0 = fall back to the global default).
    private void PersistScrollSpeed()
    {
        if (currentSheet == null || currentSheet.ScrollSpeed == _autoScrollSpeed) return;
        currentSheet.ScrollSpeed = _autoScrollSpeed;
        try { SheetService.UpdateSheet(currentSheet); } catch { }
    }

    // Timed auto-scroll: pick a duration, scroll from top to bottom over that time (scroll-v).
    private int _autoScrollMinutes = 3;
    private async Task StartTimedAutoScroll()
    {
        if (effectiveMode != "scroll-v") return;
        double range = 0;
        try { range = await JS.InvokeAsync<double>("getScrollRange"); } catch { }
        if (range <= 1) return;                                   // nothing to scroll
        int secs = Math.Max(5, _autoScrollMinutes * 60);
        _autoScrollSpeed = (int)Math.Clamp(Math.Round(range / secs), 4, 300);
        try { await JS.InvokeVoidAsync("setAutoScrollSpeed", _autoScrollSpeed); } catch { }
        PersistScrollSpeed();
        StopAutoPageTurn();
        _autoScrolling = true;
        try { if (!await JS.InvokeAsync<bool>("startAutoScroll", _autoScrollSpeed)) _autoScrolling = false; }
        catch { _autoScrolling = false; }
        StateHasChanged();
    }

    private async Task HaltAutoScroll()
    {
        _autoScrolling = false;
        try { await JS.InvokeVoidAsync("stopAutoScroll"); } catch { }
    }

    // ── Audio backing track ────────────────────────────────────────────────
    private bool   _hasAudio, _audioPlaying, _audioSeeking;
    private double _audioPos, _audioDur, _audioRate = 1.0;
    private double _resumePos;
    private bool   _resumePending;
    private static readonly double[] AudioRates = { 0.5, 0.75, 1.0, 1.25, 1.5 };
    private string PosStr   => _audioPos.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    private string MaxStr   => (_audioDur > 0 ? _audioDur : 0).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    private string RateLabel => _audioRate == 1.0 ? "1×" : $"{_audioRate.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}×";
    private int    _loopState;           // 0 = off, 1 = A marked, 2 = looping A–B
    private double _loopA, _loopB;
    private string LoopLabel => _loopState switch { 1 => "A → B?", 2 => "A–B ✓", _ => "A–B" };

    private async Task LoadAudioAsync()
    {
        _hasAudio = false; _audioPlaying = false; _audioSeeking = false; _audioPos = 0; _audioDur = 0; _audioRate = 1.0;
        _resumePos = 0; _resumePending = false;
        _loopState = 0; _loopA = _loopB = 0;
        try { await JS.InvokeVoidAsync("clearAudioLoop"); } catch { }
        if (currentSheet == null || string.IsNullOrWhiteSpace(currentSheet.AudioPath)) return;
        try
        {
            var ap = Path.Combine(SheetService.UploadFolder, currentSheet.AudioPath);
            if (!File.Exists(ap)) return;
            var bytes = await File.ReadAllBytesAsync(ap);
            if (bytes.Length == 0) return;
            _hasAudio = await JS.InvokeAsync<bool>("loadAudioData", bytes, AudioMime(currentSheet.AudioPath));
            if (_hasAudio)
            {
                try { _resumePos = await JS.InvokeAsync<double>("loadAudioPos", file ?? ""); } catch { _resumePos = 0; }
                _resumePending = _resumePos > 1;   // resume where the track was last left (set on metadata load)
            }
        }
        catch { _hasAudio = false; }
    }
    private static string AudioMime(string name) => Path.GetExtension(name).ToLowerInvariant() switch
    {
        ".mp3"                      => "audio/mpeg",
        ".m4a" or ".aac" or ".mp4"  => "audio/mp4",
        ".ogg" or ".oga" or ".opus" => "audio/ogg",
        ".wav"                      => "audio/wav",
        ".flac"                     => "audio/flac",
        _                           => "audio/mpeg"
    };
    private async Task ToggleAudioPlay()
    {
        if (!_hasAudio) return;
        _audioPlaying = !_audioPlaying;
        try { await JS.InvokeVoidAsync(_audioPlaying ? "playAudio" : "pauseAudio"); } catch { _audioPlaying = false; }
        if (!_audioPlaying) { try { await JS.InvokeVoidAsync("saveAudioPos", file ?? "", _audioPos); } catch { } }   // remember position on pause
        StateHasChanged();
    }
    private async Task AudioSkip(double delta)
    {
        double t = _audioPos + delta;
        if (t < 0) t = 0;
        if (_audioDur > 0 && t > _audioDur) t = _audioDur;
        _audioPos = t;
        try { await JS.InvokeVoidAsync("seekAudio", t); } catch { }
        StateHasChanged();
    }
    private static string FmtTime(double sec)
    {
        if (double.IsNaN(sec) || sec < 0) sec = 0;
        int s = (int)Math.Round(sec);
        return $"{s / 60}:{s % 60:00}";
    }

    [JSInvokable]
    public Task OnAudioTime(double pos, double dur) => InvokeAsync(() =>
    {
        if (dur > 0) _audioDur = dur;
        if (_resumePending && dur > 0)
        {
            _resumePending = false;
            if (_resumePos > 1 && _resumePos < dur - 1)   // skip resume if finished/near end
            {
                _audioPos = _resumePos;
                try { _ = JS.InvokeVoidAsync("seekAudio", _resumePos); } catch { }
                StateHasChanged();
                return;                                   // don't overwrite with the stale (pre-seek) pos this tick
            }
        }
        if (!_audioSeeking) _audioPos = pos;        // don't fight an in-progress scrub
        StateHasChanged();
    });
    [JSInvokable]
    public Task OnAudioEnded() => InvokeAsync(() =>
    {
        _audioPlaying = false; _audioPos = 0;
        try { _ = JS.InvokeVoidAsync("saveAudioPos", file ?? "", 0); } catch { }   // finished → next open starts over
        StateHasChanged();
    });

    private void OnSeekInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v))
        { _audioSeeking = true; _audioPos = v; }
    }
    private async Task OnSeekChange(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v))
        {
            _audioPos = v;
            try { await JS.InvokeVoidAsync("seekAudio", v); } catch { }
        }
        _audioSeeking = false;
    }
    private async Task CycleRate()
    {
        int i = Array.IndexOf(AudioRates, _audioRate);
        _audioRate = AudioRates[(i + 1) % AudioRates.Length];
        try { await JS.InvokeVoidAsync("setAudioRate", _audioRate); } catch { }
        StateHasChanged();
    }
    // A–B practice loop: tap to mark A at the current position, tap to mark B (→ loop), tap to clear.
    private async Task CycleLoop()
    {
        switch (_loopState)
        {
            case 0: _loopA = _audioPos; _loopState = 1; break;                 // mark A
            case 1:
                if (_audioPos > _loopA + 0.3)
                { _loopB = _audioPos; _loopState = 2; try { await JS.InvokeVoidAsync("setAudioLoop", _loopA, _loopB); } catch { } }
                else _loopA = _audioPos;                                       // B too close → re-mark A
                break;
            default:
                _loopState = 0; _loopA = _loopB = 0;
                try { await JS.InvokeVoidAsync("clearAudioLoop"); } catch { }
                break;
        }
        StateHasChanged();
    }

    // ── Auto-hide toolbar ─────────────────────────────────────────────────
    private void StartAutoHide()
    {
        if (!SettingsService.AutoHideToolbar() || isEditMode) return;
        try { _autoHideCts?.Cancel(); } catch { }
        _autoHideCts = new System.Threading.CancellationTokenSource();
        var token = _autoHideCts.Token;
        Task.Run(async () =>
        {
            try { await Task.Delay(3000, token); }
            catch (OperationCanceledException) { return; }
            if (token.IsCancellationRequested) return;
            try { await InvokeAsync(() => { showUi = false; StateHasChanged(); }); }
            catch { }
        }, token);
    }

    private void ResetAutoHide()
    {
        if (!SettingsService.AutoHideToolbar() || isEditMode) return;
        showUi = true;
        StartAutoHide();
    }

    private void StopAutoHide()
    {
        try { _autoHideCts?.Cancel(); } catch { }
        _autoHideCts = null;
    }

