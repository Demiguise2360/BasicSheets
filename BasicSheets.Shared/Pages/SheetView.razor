    private sealed class SearchHit { public int page { get; set; } public string snippet { get; set; } = ""; public int count { get; set; } public int matchStart { get; set; } public int matchLen { get; set; } }
    // Split a result snippet into (before, matched term, after) so the UI can bold the term.
    private static (string pre, string match, string post) SnippetParts(SearchHit h)
    {
        var s = h.snippet ?? "";
        if (h.matchLen <= 0 || h.matchStart < 0 || h.matchStart + h.matchLen > s.Length) return (s, "", "");
        return (s.Substring(0, h.matchStart), s.Substring(h.matchStart, h.matchLen), s.Substring(h.matchStart + h.matchLen));
    }

