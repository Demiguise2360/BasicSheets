    }
    private void CancelBookmark() { showBookmarkDialog = false; }

    private void SaveBookmark()
    {
        if (string.IsNullOrEmpty(file)) return;
        int bmPage = IsHalfTurnMode ? (currentPage + 1) / 2 : currentPage;
        if (existingBookmark != null)
        {
            existingBookmark.Label = bookmarkLabel;
            existingBookmark.Color = bookmarkColor;
            BookmarkService.Update(existingBookmark);
        }
        else
        {
            var name = SheetService.GetSheets()
                           .FirstOrDefault(s => Path.GetFileName(s.FilePath) == file)?.Name ?? file;
            BookmarkService.Add(new Bookmark
            {
                PdfFile   = file,
                SheetName = name,
                Page      = bmPage,
                Label     = bookmarkLabel,
                Color     = bookmarkColor
            });
        }
        RefreshPageBookmark();
        showBookmarkDialog = false;
    }

    private void RemoveBookmark()
    {
        if (existingBookmark != null) BookmarkService.Remove(existingBookmark.Id);
        RefreshPageBookmark();
        showBookmarkDialog = false;
    }

    // ── Gesture handler ───────────────────────────────────────────────────
    [JSInvokable]
    public async Task OnGesture(string action)
    {
        try
        {
            switch (action)
            {
                case "go_home":
                    await InvokeAsync(() => Nav.NavigateTo("/"));
                    break;
                case "add_bookmark":
                    await InvokeAsync(() => { OpenBookmarkDialog(); StateHasChanged(); });
                    break;
                case "next_page":
                    if (currentPage < pageCount)
                    {
                        currentPage++;
                        RefreshPageBookmark();
                        await InvokeAsync(async () => { await RenderCurrent(); StateHasChanged(); });
                    }
                    break;
                case "prev_page":
                    if (currentPage > 1)
                    {
                        currentPage--;
                        RefreshPageBookmark();
                        await InvokeAsync(async () => { await RenderCurrent(); StateHasChanged(); });
                    }
                    break;
                case "first_page":
                    currentPage = 1;
                    RefreshPageBookmark();
                    await InvokeAsync(async () => { await RenderCurrent(); StateHasChanged(); });
                    break;
                case "last_page":
                    currentPage = pageCount;
                    RefreshPageBookmark();
                    await InvokeAsync(async () => { await RenderCurrent(); StateHasChanged(); });
                    break;
                case "toggle_edit":
                    await InvokeAsync(async () => { await TakeNotes(); StateHasChanged(); });
                    break;
                case "zoom_reset":
                    await JS.InvokeVoidAsync("fitToWidthPublic");
                    break;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SheetView] Geste «{action}» fehlgeschlagen: {ex.Message}");
        }
    }

    [JSInvokable]
    public async Task OnStylusEvent(bool entering)
    {
        try
        {
            if (entering && !isEditMode)
                await InvokeAsync(async () => { await TakeNotes(); StateHasChanged(); });
            else if (!entering && isEditMode)
                await InvokeAsync(async () => { await TakeNotes(); StateHasChanged(); });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SheetView] Stylus-Event fehlgeschlagen: {ex.Message}");
        }
    }

    // Stylus front button → eraser (engaged/restored from JS). Updates the UI only;
    // the drawing engine already switched the tool locally.
    [JSInvokable]
    public Task OnStylusEraser(bool active, string toolName) => InvokeAsync(() =>
    {
        activeTool = toolName;
        if (toolColors.TryGetValue(toolName, out var c)) activeColor = c;
        StateHasChanged();
    });

    // ── Quick panel helpers ───────────────────────────────────────────────
    private void ToggleQuickPanel(int tab)
    {
        if (showQuickPanel && quickPanelTab == tab) showQuickPanel = false;
        else { quickPanelTab = tab; showQuickPanel = true; }
    }

    private void ToggleScreenOn(Setting s)
    {
        s.Value = s.Value == "true" ? "false" : "true";
        SettingsService.SaveSettings();
        _ = JS.InvokeVoidAsync("setWakeLock", s.Value == "true");
    }

    private void SetViewerBg(string bg)
    {
        viewerBg = bg;
        var s = SettingsService.GetSettings().FirstOrDefault(x => x.Name == "Viewer-Hintergrund");
        if (s != null) { s.Value = bg; SettingsService.SaveSettings(); }
    }

    private async Task JumpToBookmark(Bookmark bm)
    {
        currentPage = Math.Clamp(bm.Page, 1, pageCount);
        RefreshPageBookmark();
        await RenderCurrent();
        showQuickPanel = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        StopAutoPageTurn();
        StopAutoHide();
        try { _ = JS.InvokeVoidAsync("setWakeLock", false); } catch { }
        _ref?.Dispose();
    }
}
