    // ── Page order (reorder / duplicate / hide pages) ──────────────────────
    private List<int> _pageOrder = new();
    private bool HasPageOrder => _pageOrder.Count > 0;
    private int PdfPageFor(int displayPage)
    {
        if (HasPageOrder)
            return _pageOrder[Math.Clamp(displayPage - 1, 0, _pageOrder.Count - 1)];
        return displayPage + _pageOffset;
    }

    private bool _pageMgrMode;
    private List<int> _pageMgrList = new();
    private int _pmgrAddPage = 1;

    private void OpenPageMgr()
    {
        if (_isText || _isImage || _hasRange || totalPages <= 1) return;
        _pageMgrList = HasPageOrder ? new List<int>(_pageOrder) : Enumerable.Range(1, totalPages).ToList();
        _pmgrAddPage = 1;
        showQuickPanel = false;
        _pageMgrMode = true;
    }
    private void PmMoveUp(int i)    { if (i > 0) (_pageMgrList[i - 1], _pageMgrList[i]) = (_pageMgrList[i], _pageMgrList[i - 1]); }
    private void PmMoveDown(int i)  { if (i < _pageMgrList.Count - 1) (_pageMgrList[i + 1], _pageMgrList[i]) = (_pageMgrList[i], _pageMgrList[i + 1]); }
    private void PmDuplicate(int i) { _pageMgrList.Insert(i + 1, _pageMgrList[i]); }
    private void PmRemove(int i)    { if (_pageMgrList.Count > 1) _pageMgrList.RemoveAt(i); }
    private void PmReset()          { _pageMgrList = Enumerable.Range(1, totalPages).ToList(); }
    private void PmAddPage()        { if (_pmgrAddPage >= 1 && _pmgrAddPage <= totalPages) _pageMgrList.Add(_pmgrAddPage); }
    private void CancelPageMgr()    { _pageMgrMode = false; }

    private async Task SavePageMgr()
    {
        _pageMgrMode = false;
        bool natural = PageOrderUtil.IsNatural(_pageMgrList, totalPages);
        _pageOrder = natural ? new List<int>() : new List<int>(_pageMgrList);
        if (currentSheet != null)
        {
            currentSheet.PageOrder = natural ? "" : PageOrderUtil.Serialize(_pageMgrList);
            try { SheetService.UpdateSheet(currentSheet); } catch { }
        }
        RecalcPageCount();
        currentPage = Math.Clamp(currentPage, 1, pageCount);
        await RenderCurrent();
        StateHasChanged();
    }

