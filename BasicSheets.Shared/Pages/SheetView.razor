    // ── Metronome ─────────────────────────────────────────────────────────
    private int  _metroBpm = 100;
    private int  _metroBeats = 4;
    private bool _metroRunning;
    private bool _metroMuted;
    private bool _metroAccent = true;
    private int  _metroSubdiv = 1;

    private async Task ToggleMetronome()
    {
        if (_metroRunning)
        {
            _metroRunning = false;
            try { await JS.InvokeVoidAsync("stopMetronome"); } catch { }
        }
        else
        {
            _metroRunning = true;
            try { if (!await JS.InvokeAsync<bool>("startMetronome", _metroBpm, _metroBeats)) _metroRunning = false; }
            catch { _metroRunning = false; }
        }
        StateHasChanged();
    }
    private async Task SetMetroBpm(int delta)
    {
        _metroBpm = Math.Clamp(_metroBpm + delta, 20, 300);
        PersistMetro();
        try { await JS.InvokeVoidAsync("setMetronomeBpm", _metroBpm); } catch { }
        StateHasChanged();
    }
    private async Task SetMetroBeats(int b)
    {
        _metroBeats = Math.Clamp(b, 1, 16);
        PersistMetro();
        try { await JS.InvokeVoidAsync("setMetronomeBeats", _metroBeats); } catch { }
        StateHasChanged();
    }
    private async Task ToggleMetroMute()
    {
        _metroMuted = !_metroMuted;
        try { await JS.InvokeVoidAsync("setMetronomeMuted", _metroMuted); } catch { }
        StateHasChanged();
    }
    private async Task ToggleMetroAccent()
    {
        _metroAccent = !_metroAccent;
        try { await JS.InvokeVoidAsync("setMetronomeAccent", _metroAccent); } catch { }
        StateHasChanged();
    }
    private async Task SetMetroSubdiv(int n)
    {
        _metroSubdiv = Math.Clamp(n, 1, 4);
        try { await JS.InvokeVoidAsync("setMetronomeSubdiv", _metroSubdiv); } catch { }
        StateHasChanged();
    }
    private void PersistMetro()
    {
        if (currentSheet != null)
        {
            currentSheet.Bpm   = _metroBpm;
            currentSheet.Beats = _metroBeats;
            SheetService.UpdateSheet(currentSheet);
        }
    }

    // Tap-tempo: BPM from the average interval of recent taps (resets after a 2s gap).
    private readonly List<DateTime> _tapTimes = new();
    private async Task TapTempo()
    {
        var now = DateTime.UtcNow;
        if (_tapTimes.Count > 0 && (now - _tapTimes[^1]).TotalSeconds > 2) _tapTimes.Clear();
        _tapTimes.Add(now);
        if (_tapTimes.Count > 6) _tapTimes.RemoveAt(0);
        if (_tapTimes.Count >= 2)
        {
            double avgMs = (_tapTimes[^1] - _tapTimes[0]).TotalMilliseconds / (_tapTimes.Count - 1);
            if (avgMs > 0)
            {
                _metroBpm = Math.Clamp((int)Math.Round(60000.0 / avgMs), 20, 300);
                PersistMetro();
                try { await JS.InvokeVoidAsync("setMetronomeBpm", _metroBpm); } catch { }
            }
        }
        StateHasChanged();
    }

    private async Task JumpToBookmark(Bookmark bm)
