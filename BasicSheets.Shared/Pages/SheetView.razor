    // ── Text overlay ─────────────────────────────────────────────────────
    private async Task OnTextKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ConfirmText();
        else if (e.Key == "Escape") CancelText();
    }
    private async Task ConfirmText()
    {
        try
        {
            int fontSize = ActiveSize * 3 + 10;
            if (_textEditIndex >= 0)
            {
                // Editing an existing note: update it in place (clearing the text deletes it).
                await JS.InvokeVoidAsync("updateTextAnnotation", _textEditIndex, textValue, activeColor, fontSize);
            }
            else if (!string.IsNullOrWhiteSpace(textValue))
            {
                await JS.InvokeVoidAsync("drawTextOnCanvas", textCanvasX, textCanvasY,
                                         textValue, activeColor, fontSize);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SheetView] Text konnte nicht gezeichnet werden: {ex.Message}");
        }
        showTextInput = false; textValue = ""; _textEditIndex = -1;
    }
    private void CancelText() { showTextInput = false; textValue = ""; _textEditIndex = -1; }

    // ── Page navigation ───────────────────────────────────────────────────
    private async Task OnSlider(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var page)) return;
        currentPage = Math.Clamp(page, 1, pageCount);
        RefreshPageBookmark();
        await RenderCurrent();
        if (SettingsService.RememberLastPage())
            _ = JS.InvokeVoidAsync("saveLastPage", file, currentPage);
    }

    // ── Go-to-page: tap the "page / total" readout to type a page number ──
    private void OpenPageInput()
    {
        _pageInputVal  = currentPage.ToString();
        _showPageInput = true;
        _focusPageInput = true;
    }

    private async Task PageInputKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter") await CommitPageInput();
        else if (e.Key == "Escape") ClosePageInput();
    }

    private async Task CommitPageInput()
    {
        if (int.TryParse(_pageInputVal, out var p))
        {
            p = Math.Clamp(p, 1, pageCount);
            _showPageInput = false;
            if (p != currentPage) await JumpPage(p);
            else StateHasChanged();
        }
        else ClosePageInput();
    }

    private void ClosePageInput()
    {
        _showPageInput = false;
        StateHasChanged();
    }

    // ── Export / share the current page as an image (annotations baked in) ──
    private bool CanExportPage => !_isText && !IsScrollMode;   // scroll = one big composite; text = no canvas

    private async Task ExportCurrentPage()
    {
        showActionBox = false;
        try
        {
            var dataUrl = await JS.InvokeAsync<string?>("exportPagePng");
            if (string.IsNullOrEmpty(dataUrl) || !dataUrl.Contains(','))
            {
                ShowErrorMessage("Diese Ansicht kann nicht als Bild exportiert werden.");
                return;
            }
            var name = $"{SanitizeFileName(currentSheet?.Name ?? "Seite")}_S{currentPage}.png";
            if (_shareService != null)   // MAUI → native share sheet
            {
                var bytes = Convert.FromBase64String(dataUrl[(dataUrl.IndexOf(',') + 1)..]);
                await _shareService.ShareImageAsync(bytes, name, "Seite teilen");
            }
            else                         // web → browser download
            {
                await JS.InvokeVoidAsync("downloadDataUrl", dataUrl, name);
            }
        }
        catch (Exception ex)
        {
            ShowErrorMessage($"Export fehlgeschlagen: {ex.Message}");
        }
    }

    private static string SanitizeFileName(string name)
    {
        foreach (var c in Path.GetInvalidFileNameChars()) name = name.Replace(c, '_');
        name = name.Trim();
        return string.IsNullOrEmpty(name) ? "Seite" : name;
    }

    // ── Freehand-notes backup / restore ───────────────────────────────────
    // Pen/marker/stamp/text/hairpin/shape annotations live only in the browser's
    // localStorage (bookmarks, link points and tempo are in the DB). These save a
    // copy to a file and restore it — e.g. before clearing data or on a new device.
    private async Task ExportAnnotations()
    {
        showActionBox = false;
        try
        {
            var json = await JS.InvokeAsync<string?>("exportAnnotationsJson");
            if (string.IsNullOrEmpty(json))
            {
                ShowNotice("Keine Notizen zum Sichern vorhanden.");
                return;
            }
            var name = $"BasicSheets-Notizen_{DateTime.Now:yyyy-MM-dd}.json";
            if (_shareService != null)   // MAUI → native share sheet
            {
                var bytes = System.Text.Encoding.UTF8.GetBytes(json);
                await _shareService.ShareFileAsync(bytes, name, "Notizen sichern");
            }
            else                         // web → browser download
            {
                var b64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(json));
                await JS.InvokeVoidAsync("downloadDataUrl", "data:application/json;base64," + b64, name);
            }
        }
        catch (Exception ex)
        {
            ShowErrorMessage($"Sicherung fehlgeschlagen: {ex.Message}");
        }
    }

    private async Task ImportAnnotations()
    {
        showActionBox = false;
        try
        {
            var n = await JS.InvokeAsync<int>("importAnnotationsPick");
            if (n < 0)  { ShowErrorMessage("Datei konnte nicht gelesen werden (kein gültiges Backup)."); return; }
            if (n == 0) { return; }   // cancelled / nothing imported
            await RenderCurrent();     // reloads this page's notes so restored marks appear at once
            ShowNotice($"{n} wiederhergestellt. Andere Dokumente zeigen die Notizen beim nächsten Öffnen.");
        }
        catch (Exception ex)
        {
            ShowErrorMessage($"Wiederherstellung fehlgeschlagen: {ex.Message}");
        }
    }

    // Transient neutral toast (reuses the vnotice slot), auto-clears after a moment.
    private void ShowNotice(string msg)
    {
        _batchNotice = msg;
        StateHasChanged();
        var token = msg;
        _ = Task.Run(async () =>
        {
            await Task.Delay(2600);
            await InvokeAsync(() => { if (_batchNotice == token) { _batchNotice = null; StateHasChanged(); } });
        });
    }

    private async Task RenderCurrent()
    {
        if (_isText) return;   // text songs render in Blazor markup, not on the canvas
        try
        {
            if (_isImage)
            {
                var icrop = _crops.GetValueOrDefault(1);
                if (icrop != null) await JS.InvokeVoidAsync("setCrop", icrop.L, icrop.T, icrop.R, icrop.B);
                else await JS.InvokeVoidAsync("clearCrop");
                await JS.InvokeVoidAsync("renderImage");
                await PushPageButtons();
                return;
            }
            if (effectiveMode == "scroll-v")
            {
                await JS.InvokeVoidAsync("setPageSequence", _pageOrder.ToArray());
                await JS.InvokeVoidAsync("renderAllV");
            }
            else if (effectiveMode == "scroll-h")
            {
                await JS.InvokeVoidAsync("setPageSequence", _pageOrder.ToArray());
                await JS.InvokeVoidAsync("renderAllH");
            }
            else if (IsHalfTurnMode)
            {
                int  pdfPage = PdfPageFor((currentPage + 1) / 2);   // maps the display slot → PDF page (honors a custom order)
                bool topHalf = currentPage % 2 == 1;
                await JS.InvokeVoidAsync("renderHalfTurn", pdfPage, topHalf, (currentPage + 1) / 2);
            }
            else if (effectiveMode == "two")
            {
                await JS.InvokeVoidAsync("setPageSequence", _pageOrder.ToArray());
                await JS.InvokeVoidAsync("renderTwoPage", currentPage);
            }
            else
            {
                int pdfPage = PdfPageFor(currentPage);
                var crop = _crops.GetValueOrDefault(pdfPage);
                if (crop != null) await JS.InvokeVoidAsync("setCrop", crop.L, crop.T, crop.R, crop.B);
                else await JS.InvokeVoidAsync("clearCrop");
                await JS.InvokeVoidAsync("renderPage", pdfPage, currentPage);
            }
            await PushPageButtons();
        }
        catch (Exception ex)
        {
            ShowErrorMessage($"Seite konnte nicht gerendert werden: {ex.Message}");
        }
    }

    // Push the current page's link-point markers to the viewer overlay. Empty in modes
    // where link points don't apply, which also clears any stale markers from a prior page.
    private async Task PushPageButtons()
    {
        var list = new List<object>();
        if (LinksVisible)
        {
            // Send every point (with its source display page); the viewer places each on
            // the right page for the current mode and skips those not currently on screen.
            foreach (var b in _linkPoints.Where(b => b.SourceNX >= 0))
                list.Add(new { id = b.Id, page = b.SourcePage, nx = b.SourceNX, ny = b.SourceNY, label = b.Label, color = b.Color, isTarget = false });
        }
        try { await JS.InvokeVoidAsync("setPageButtons", list); } catch { }
    }

    private async Task HandleClick(MouseEventArgs e)
    {
        // Text songs scroll freely: a tap only toggles the toolbar (no page zones).
        if (_isText)
        {
            if (SettingsService.AutoHideToolbar()) { showUi = true; ResetAutoHide(); }
            else { showUi = !showUi; }
            StateHasChanged();
            return;
        }

        // Touch lock: ignore page-turn and link taps (stops accidental turns while reading);
        // a tap still reveals the toolbar so the lock can be switched off.
        if (_touchLocked)
        {
            if (SettingsService.AutoHideToolbar()) { showUi = true; ResetAutoHide(); }
            else { showUi = !showUi; }
            StateHasChanged();
            return;
        }

        // Link points: while armed, a tap drops a new point; otherwise a tap on an
        // existing point jumps to its target page. Checked before the page-turn zones.
        if (LinksVisible)
        {
            if (_placingLink) { await PlaceLinkAt(e.ClientX, e.ClientY); return; }
            try
            {
                var hit = await JS.InvokeAsync<string?>("getButtonAtScreen", e.ClientX, e.ClientY);
                if (!string.IsNullOrEmpty(hit) && hit.EndsWith(":source"))
                {
                    var lp = _linkPoints.FirstOrDefault(b => b.Id == hit[..^7]);
                    // TargetPage is a display page; route through JumpToPdfPage so the jump
                    // lands correctly in scroll / half-turn / custom-order modes too.
                    if (lp != null) { await JumpToPdfPage(PdfPageFor(lp.TargetPage)); ResetAutoHide(); return; }
                }
            }
            catch { }
        }

        if (IsScrollMode)
        {
            // Scroll modes have no page-turn zones, so a double-tap anywhere just zooms.
            var tnow = DateTime.UtcNow;
            if ((tnow - _lastCenterTapAt).TotalMilliseconds < 300)
            {
                _lastCenterTapAt = DateTime.MinValue;
                _ = JS.InvokeVoidAsync("toggleZoomAt", e.ClientX, e.ClientY);
                return;
            }
            _lastCenterTapAt = tnow;
        }

        if (!enableHandleClick || IsScrollMode) return;

        double x, w;
        try { w = await JS.InvokeAsync<double>("getWindowWidth"); }
        catch { return; }
        x = e.ClientX;

        if (x < w * 0.35 && currentPage > 1)
        {
            currentPage--;
            RefreshPageBookmark();
            await RenderCurrent();
            ResetAutoHide();
            if (SettingsService.RememberLastPage())
                _ = JS.InvokeVoidAsync("saveLastPage", file, currentPage);
        }
        else if (x > w * 0.65 && currentPage < pageCount)
        {
            currentPage++;
            RefreshPageBookmark();
            await RenderCurrent();
            ResetAutoHide();
            if (SettingsService.RememberLastPage())
                _ = JS.InvokeVoidAsync("saveLastPage", file, currentPage);
        }
        else if (x < w * 0.35 && currentPage == 1)
        {
            if (HasPrevSong) { GoPrevSong(); return; }
            if (!SettingsService.startAndEndHints()) return;
            showStart = true; StateHasChanged();
            await Task.Delay(2000);
            showStart = false; StateHasChanged();
        }
        else if (x > w * 0.65 && currentPage == pageCount)
        {
            if (HasNextSong) { GoNextSong(); return; }
            if (!SettingsService.startAndEndHints()) return;
            showEnd = true; StateHasChanged();
            await Task.Delay(2000);
            showEnd = false; StateHasChanged();
        }
        else
        {
            // Double-tap in the centre zone → smart zoom to the tap point. Centre taps only
            // toggle chrome, so this never fights the edge page-turn zones.
            var now = DateTime.UtcNow;
            if ((now - _lastCenterTapAt).TotalMilliseconds < 300)
            {
                _lastCenterTapAt = DateTime.MinValue;
                _ = JS.InvokeVoidAsync("toggleZoomAt", e.ClientX, e.ClientY);
                return;
            }
            _lastCenterTapAt = now;
            if (SettingsService.AutoHideToolbar()) { showUi = true; ResetAutoHide(); }
            else { showUi = !showUi; }
            StateHasChanged();
        }
    }

