    // ── PDF embedded outline (table of contents) ───────────────────────────
    private class OutlineEntry { public string Title { get; set; } = ""; public int Page { get; set; } public int Level { get; set; } }
    private List<OutlineEntry> _outline = new();
    private bool _outlineLoaded;
    // Outline works in every display mode (JumpOutline maps the PDF page per mode).
    private bool CanShowOutline => !_isText && !_isImage && !_hasRange;
    private static string OlPad(int level) =>
        (0.6 + level * 0.9).ToString(System.Globalization.CultureInfo.InvariantCulture);

    private async Task LoadOutlineAsync()
    {
        if (_outlineLoaded) return;
        _outlineLoaded = true;
        try
        {
            var entries = await JS.InvokeAsync<OutlineEntry[]>("getPdfOutline");
            // Outline pages are absolute PDF pages → bound by totalPages (pageCount is 1 in scroll modes).
            _outline = entries?.Where(e => e.Page >= 1 && e.Page <= totalPages).ToList() ?? new();
        }
        catch { _outline = new(); }
        StateHasChanged();
    }

    private async Task JumpOutline(OutlineEntry e)
    {
        showActionBox = false;
        await JumpToPdfPage(e.Page);
    }

    // Jump to an absolute PDF page, mapping it to the right display slot for the current
    // mode (scroll / half-turn / custom-order / natural). Shared by the outline and grid.
    private async Task JumpToPdfPage(int pdfPage)
    {
        if (IsScrollMode)
        {
            try { await JS.InvokeVoidAsync("scrollToPdfPage", pdfPage); } catch { }
            StateHasChanged();
            return;
        }
        if (IsHalfTurnMode)
        {
            int d = HasPageOrder ? _pageOrder.IndexOf(pdfPage) + 1 : pdfPage;   // display slot showing this PDF page
            if (d < 1) d = 1;
            currentPage = Math.Clamp(2 * d - 1, 1, pageCount);                 // top half of that slot
            RefreshPageBookmark();
            await RenderCurrent();
            StateHasChanged();
            return;
        }
        if (HasPageOrder && (effectiveMode == "single" || effectiveMode == "two"))
        {
            int d = _pageOrder.IndexOf(pdfPage) + 1;                   // display slot showing this PDF page
            await JumpPage(d >= 1 ? d : 1);
            return;
        }
        await JumpPage(pdfPage);                                       // single/two-page (natural): PDF page directly
    }

    // ── Page overview grid ─────────────────────────────────────────────────
    private int CurrentPdfPage()
    {
        var order = GridOrder;
        if (order.Count == 0) return 1;
        if (IsScrollMode)   { int idx = Math.Clamp(_scrollSlot, 0, order.Count - 1); return order[idx]; }
        if (IsHalfTurnMode) return PdfPageFor((currentPage + 1) / 2);
        return PdfPageFor(currentPage);                               // single / two
    }

    private async Task OpenPageGrid()
    {
        if (!CanShowPageGrid) return;
        showQuickPanel = false;
        showActionBox  = false;
        showModeDropdown = false;
        if (IsScrollMode)
        {
            try { _scrollSlot = await JS.InvokeAsync<int>("getScrollSlot"); } catch { }
            if (_scrollSlot < 0) _scrollSlot = 0;
        }
        _gridCurrentPdfPage = CurrentPdfPage();
        _gridBookmarks.Clear();
        foreach (var bm in BookmarkService.GetForFile(file ?? ""))
            _gridBookmarks[bm.Page] = string.IsNullOrEmpty(bm.Color) ? "#4d8a80" : bm.Color;
        try { _gridAnnotated = new(await JS.InvokeAsync<int[]>("getAnnotatedPages")); } catch { _gridAnnotated = new(); }
        _showPageGrid = true;
        StateHasChanged();
        await RenderGridThumbs();
    }

    private void ClosePageGrid() { _showPageGrid = false; StateHasChanged(); }

    private async Task RenderGridThumbs()
    {
        int since = 0;
        foreach (var p in GridOrder)
        {
            if (!_showPageGrid) return;                               // user closed it mid-render
            if (_pageThumbs.ContainsKey(p)) continue;
            string? t = null;
            try { t = await JS.InvokeAsync<string?>("renderPageThumb", p, 170); } catch { }
            _pageThumbs[p] = t ?? "";
            if (++since >= 4) { since = 0; StateHasChanged(); }       // reveal thumbnails as they arrive
        }
        StateHasChanged();
    }

    private async Task OnGridJump(int pdfPage)
    {
        _showPageGrid = false;
        await JumpToPdfPage(pdfPage);
    }

    // ── In-document text search ────────────────────────────────────────────
    private void OpenSearch()
    {
        showQuickPanel   = false;
        showActionBox    = false;
        showModeDropdown = false;
        _searchQuery = ""; _searchResults = new(); _searched = false;   // fresh box each open → recent-term chips show
        _showSearch = true;
        _ = JS.InvokeVoidAsync("prewarmSearchCache");   // warm the text cache while the user types
        _ = LoadRecentSearches();                        // show recent terms as tap chips while the box is empty
        StateHasChanged();
    }

    private async Task LoadRecentSearches()
    {
        try { _recentSearches = (await JS.InvokeAsync<string[]>("getRecentSearches")).ToList(); StateHasChanged(); }
        catch { }
    }

    private void CloseSearch() { _showSearch = false; StateHasChanged(); }

    // Live search: debounce keystrokes, then search once typing settles.
    private System.Threading.CancellationTokenSource? _searchCts;
    private async Task OnSearchInput()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        var cts = new System.Threading.CancellationTokenSource();
        _searchCts = cts;
        var q = (_searchQuery ?? "").Trim();
        if (q.Length < 2) { _searchResults = new(); _searched = false; _searching = false; StateHasChanged(); return; }
        try { await Task.Delay(300, cts.Token); }
        catch (OperationCanceledException) { return; }
        if (!cts.IsCancellationRequested && _showSearch) await DoSearch();
    }

    private async Task OnSearchKey(KeyboardEventArgs e) { if (e.Key == "Enter") await DoSearchCommit(); }

    private async Task DoSearch()
    {
        var q = (_searchQuery ?? "").Trim();
        _searched = true;
        _showMatchNav = false; _searchIdx = -1;   // a new search supersedes the old match navigator
        if (q.Length < 2) { _searchResults = new(); StateHasChanged(); return; }   // need at least 2 chars
        _searching = true;
        StateHasChanged();
        try { var hits = await JS.InvokeAsync<SearchHit[]>("searchPdf", q); _searchResults = hits?.ToList() ?? new(); }
        catch { _searchResults = new(); }
        _searching = false;
        StateHasChanged();
    }

    // An explicit search (Enter / the "Suchen" button / a recent chip): remember the term.
    private async Task DoSearchCommit()
    {
        await DoSearch();
        var q = (_searchQuery ?? "").Trim();
        if (q.Length >= 2 && _searchResults.Count > 0)
        {
            try { await JS.InvokeVoidAsync("pushRecentSearch", q); } catch { }
            _ = LoadRecentSearches();
        }
    }

    private async Task UseRecentSearch(string term)
    {
        _searchQuery = term;
        await DoSearch();   // show results; the term is already in the recent list
        StateHasChanged();
    }

    private async Task ClearRecentSearches()
    {
        try { await JS.InvokeVoidAsync("clearRecentSearches"); } catch { }
        _recentSearches = new();
        StateHasChanged();
    }

    private async Task OnSearchJump(SearchHit h)
    {
        var q = _searchQuery;
        _searchActiveQuery = q ?? "";
        if ((q ?? "").Trim().Length >= 2) { try { await JS.InvokeVoidAsync("pushRecentSearch", (q ?? "").Trim()); } catch { } }
        _searchIdx = _searchResults.IndexOf(h);
        _showMatchNav = true;
        _showSearch = false;
        await JumpToPdfPage(h.page);
        // Flash the matches on the target page: single (unrotated) + both scroll modes; JS no-ops elsewhere.
        if (!string.IsNullOrWhiteSpace(q))
            try { await JS.InvokeAsync<bool>("highlightMatch", q, h.page); } catch { }
    }

    // Step through the search results (prev/next page with matches), re-highlighting each.
    private async Task MatchNav(int delta)
    {
        if (_searchResults.Count == 0) return;
        _searchIdx = Math.Clamp(_searchIdx + delta, 0, _searchResults.Count - 1);
        var h = _searchResults[_searchIdx];
        await JumpToPdfPage(h.page);
        if (!string.IsNullOrWhiteSpace(_searchActiveQuery))
            try { await JS.InvokeAsync<bool>("highlightMatch", _searchActiveQuery, h.page); } catch { }
        StateHasChanged();
    }

    private void CloseMatchNav() { _showMatchNav = false; StateHasChanged(); }

    private async Task ToggleLock()
    {
        _touchLocked = !_touchLocked;
        _lockMsg = _touchLocked ? "Tippen gesperrt" : "Tippen entsperrt";
        StateHasChanged();
        var shown = _lockMsg;
        await Task.Delay(1400);
        if (_lockMsg == shown) { _lockMsg = null; StateHasChanged(); }
    }

    private async Task JumpPage(int p)
    {
        p = Math.Clamp(p, 1, pageCount);
        if (p == currentPage) return;
        if (!_suppressBackPush && Math.Abs(p - currentPage) > 1)   // a deliberate jump, not a sequential turn → remember where we were
        {
            _backStack.Add(currentPage);
            if (_backStack.Count > 30) _backStack.RemoveAt(0);
        }
        currentPage = p;
        RefreshPageBookmark();
        await RenderCurrent();
        if (SettingsService.RememberLastPage()) _ = JS.InvokeVoidAsync("saveLastPage", file, currentPage);
        StateHasChanged();
    }

    // Return to the page we jumped from (multi-level); suppress the push so returning doesn't re-stack.
    private async Task GoBackJump()
    {
        if (_backStack.Count == 0) return;
        var target = _backStack[^1];
        _backStack.RemoveAt(_backStack.Count - 1);
        _suppressBackPush = true;
        try { await JumpPage(target); }
        finally { _suppressBackPush = false; }
    }

    // ── Smart buttons (on-screen quick-jump buttons) ────────────────────────
    private async Task SmartAction(ViewerButton b)
    {
        if (b.Action == "first") await JumpPage(1);
        else if (b.Action == "last") await JumpPage(pageCount);
        else if (int.TryParse(b.Param, out var p)) await JumpPage(Math.Clamp(p, 1, pageCount));
    }

