@page "/"
@using BasicSheets.Shared.Services
@using BasicSheets.Shared.Models;
@inject SheetService SheetService;
@inject SetlistService SetlistService;
@inject CollectionService CollectionService;
@inject ThumbnailService ThumbnailService;
@inject NavigationManager navigationManager;
@inject IJSRuntime JsRuntime
@inject SettingsService SettingsService

<PageTitle>BasicSheets</PageTitle>

@if (UpdateService?.UpdateAvailable == true)
{
    <div class="update-banner @(UpdateService.IsDownloading ? "update-banner-busy" : "")"
         @onclick="DoUpdate">
        @if (UpdateService.IsDownloading)
        {
            <div class="update-banner-text">
                <strong>Wird heruntergeladen…</strong>
                <span>@UpdateService.DownloadPercent %</span>
            </div>
            <div class="update-progress">
                <div class="update-progress-bar" style="width:@(UpdateService.DownloadPercent)%"></div>
            </div>
        }
        else
        {
            <div class="update-banner-text">
                <strong>Update verfügbar</strong>
                <span>Version @UpdateService.NewVersion</span>
            </div>
            <span class="update-banner-btn">Installieren</span>
        }
    </div>
    @if (!string.IsNullOrEmpty(UpdateService.ErrorMessage))
    {
        <div class="field-error" style="margin:0.25rem 1rem 0">@UpdateService.ErrorMessage</div>
    }
}

<div class="pg-title">Meine Noten</div>

@* ── Library pivot tabs ──────────────────────────────────────────── *@
<div class="lib-pivots">
    @foreach (var p in Pivots)
    {
        var pv = p;
        <button class="lib-pivot @(tab == pv.Key ? "lib-pivot-on" : "")" @onclick="() => SetTab(pv.Key)">@pv.Label</button>
    }
</div>

@if (tab == "songs")
{
    <div class="search-container">
        <input placeholder="Suchen …" @bind="searchText" @bind:event="oninput" />
        <select @bind="selectedField">
            <option value="all">Alle</option>
            <option value="Name">Name</option>
            <option value="Composer">Komponist</option>
            <option value="Part">Stimme</option>
            <option value="Genre">Genre</option>
            <option value="Tags">Tags</option>
        </select>
    </div>
}

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="field-error" style="margin:0 1rem 0.5rem">@statusMessage</div>
}

<div class="main-container">

    @if (tab == "songs")
    {
        @if (FilteredSheets.Count > 0)
        {
            @foreach (var sheet in FilteredSheets) { @SheetCard(sheet) }
        }
        else if (!string.IsNullOrWhiteSpace(searchText))
        {
            <div class="empty-state"><p class="empty-title">Keine Treffer</p><p class="empty-sub">Keine Noten gefunden für «@searchText»</p></div>
        }
        else
        {
            <div class="empty-state"><p class="empty-title">Noch keine Noten</p><p class="empty-sub">Tippe auf + um eine PDF hinzuzufügen</p></div>
        }
    }
    else if (tab == "recent")
    {
        var all = SheetService.GetSheets();
        var recentSheets = _recent
            .Select(f => all.FirstOrDefault(s => Path.GetFileName(s.FilePath) == f))
            .Where(s => s != null).Cast<Sheet>().ToList();
        @if (recentSheets.Count > 0)
        {
            @foreach (var sheet in recentSheets) { @SheetCard(sheet) }
        }
        else
        {
            <div class="empty-state"><p class="empty-title">Noch nichts geöffnet</p><p class="empty-sub">Zuletzt geöffnete Noten erscheinen hier</p></div>
        }
    }
    else if (tab == "favorites")
    {
        var favs = SheetService.GetSheets().Where(s => s.Rating > 0)
                               .OrderByDescending(s => s.Rating).ThenBy(s => s.Name ?? "").ToList();
        @if (favs.Count > 0)
        {
            @foreach (var sheet in favs) { @SheetCard(sheet) }
        }
        else
        {
            <div class="empty-state"><p class="empty-title">Keine Favoriten</p><p class="empty-sub">Tippe auf die Sterne einer Note, um sie zu bewerten</p></div>
        }
    }
    else if (tab == "composer" || tab == "genre")
    {
        var groups = GroupSheets(tab);
        @if (groups.Any())
        {
            @foreach (var g in groups)
            {
                <div class="lib-section-head"><span>@g.Key</span><span class="lib-section-count">@g.Count()</span></div>
                @foreach (var sheet in g) { @SheetCard(sheet) }
            }
        }
        else
        {
            <div class="empty-state"><p class="empty-title">Noch keine Noten</p><p class="empty-sub">Tippe auf + um eine PDF hinzuzufügen</p></div>
        }
    }
    else if (tab == "setlists")
    {
        var setlists = SetlistService.GetAll();
        @foreach (var sl in setlists)
        {
            var id = sl.Id;
            <div class="setlist-card" @onclick="() => OpenSetlist(id)">
                <div class="setlist-ico">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
                        <circle cx="3.5" cy="6" r="1.2" fill="currentColor"/><circle cx="3.5" cy="12" r="1.2" fill="currentColor"/><circle cx="3.5" cy="18" r="1.2" fill="currentColor"/>
                    </svg>
                </div>
                <div class="setlist-info">
                    <div class="setlist-title">@sl.Name</div>
                    <div class="setlist-sub">@SetlistService.CountItems(id) @(SetlistService.CountItems(id) == 1 ? "Titel" : "Titel")</div>
                </div>
                <button class="act-btn act-delete" @onclick="() => DeleteSetlist(id)" @onclick:stopPropagation="true" title="Löschen">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/>
                    </svg>
                </button>
            </div>
        }
        @if (!setlists.Any())
        {
            <div class="empty-state"><p class="empty-title">Noch keine Setlists</p><p class="empty-sub">Erstelle eine Setlist, um Stücke in Reihenfolge zu spielen</p></div>
        }
        <button class="add-btn" style="margin-top:0.5rem" @onclick="CreateSetlist">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><line x1="12" y1="5" x2="12" y2="19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
            Neue Setlist
        </button>
    }
    else if (tab == "collections" && selectedCollectionId == null)
    {
        var colls = CollectionService.GetAll();
        @foreach (var c in colls)
        {
            var cid = c.Id;
            <div class="setlist-card" @onclick="() => selectedCollectionId = cid">
                <div class="setlist-ico">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                    </svg>
                </div>
                <div class="setlist-info">
                    <div class="setlist-title">@c.Name</div>
                    <div class="setlist-sub">@CollectionService.CountSheets(cid) Titel</div>
                </div>
            </div>
        }
        @if (!colls.Any())
        {
            <div class="empty-state"><p class="empty-title">Noch keine Sammlungen</p><p class="empty-sub">Weise Noten beim Bearbeiten einer Sammlung zu</p></div>
        }
    }
    else if (tab == "collections")
    {
        var coll = CollectionService.GetAll().FirstOrDefault(c => c.Id == selectedCollectionId);
        var collSheets = CollectionService.GetSheets(selectedCollectionId!.Value);
        <button class="chip-btn" style="margin-bottom:0.6rem" @onclick="() => selectedCollectionId = null">← @(coll?.Name ?? "Zurück")</button>
        @foreach (var sheet in collSheets) { @SheetCard(sheet) }
        @if (!collSheets.Any())
        {
            <div class="empty-state"><p class="empty-sub">Keine Noten in dieser Sammlung</p></div>
        }
    }
</div>

@implements IDisposable

@code {
    // Resolved optionally: the update service is only registered on the MAUI host,
    // so on other hosts (e.g. Web) this stays null and the banner is simply hidden.
    [Inject] private IServiceProvider Services { get; set; } = default!;
    private IUpdateService? UpdateService;

    private Dictionary<string, string> _thumbs = new();
    private List<string> _recent = new();   // recently-opened file names (newest first), from localStorage

    protected override void OnInitialized()
    {
        UpdateService = Services.GetService(typeof(IUpdateService)) as IUpdateService;
        _thumbs = ThumbnailService.GetAll();
    }

    private bool HasThumb(Sheet s) => _thumbs.ContainsKey(Path.GetFileName(s.FilePath));
    private string ThumbFor(Sheet s) => _thumbs.TryGetValue(Path.GetFileName(s.FilePath), out var u) ? u : "";

    string tab = "songs";
    int? selectedCollectionId;
    string searchText = "";
    string selectedField = "all";
    string? statusMessage;

    private record Pivot(string Key, string Label);
    private static readonly Pivot[] Pivots =
    [
        new("songs", "Titel"),
        new("recent", "Zuletzt"),
        new("favorites", "Favoriten"),
        new("composer", "Komponisten"),
        new("genre", "Genres"),
        new("collections", "Sammlungen"),
        new("setlists", "Setlists"),
    ];

    private void SetTab(string t) { tab = t; statusMessage = null; selectedCollectionId = null; }

    // ── Reusable song card ─────────────────────────────────────────
    private RenderFragment<Sheet> SheetCard => sheet =>
    @<div class="sheet-card" @onclick="() => OpenSheet(sheet)">
        <div class="sheet-card-inner">
            <div class="sheet-thumb @(HasThumb(sheet) ? "sheet-thumb-has-img" : "")">
                @if (HasThumb(sheet))
                {
                    <img src="@ThumbFor(sheet)" alt="" loading="lazy" />
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3" fill="currentColor"/><circle cx="18" cy="16" r="3" fill="currentColor"/>
                    </svg>
                }
            </div>
            <div class="sheet-info">
                <h3 class="sheet-name">@sheet.Name</h3>
                @if (!string.IsNullOrWhiteSpace(sheet.GetInformation()))
                {
                    <p class="sheet-meta">@sheet.GetInformation()</p>
                }
                @if (!string.IsNullOrWhiteSpace(sheet.Tags) || !string.IsNullOrWhiteSpace(sheet.Difficulty))
                {
                    <div class="sheet-tags">
                        @if (!string.IsNullOrWhiteSpace(sheet.Difficulty))
                        {
                            <span class="sheet-tag sheet-tag-diff sheet-tag-diff-@sheet.Difficulty">@DiffLabel(sheet.Difficulty)</span>
                        }
                        @foreach (var t in (sheet.Tags ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <span class="sheet-tag">@t</span>
                        }
                    </div>
                }
                <div style="display:flex;gap:1px;margin-top:0.3rem">
                    @for (int si = 1; si <= 5; si++)
                    {
                        var n = si;
                        <button @onclick="() => SetRating(sheet, n)" @onclick:stopPropagation="true"
                                title="@n von 5 Sternen"
                                style="background:none;border:none;padding:0 2px;cursor:pointer;font-size:1.05rem;line-height:1;color:@(sheet.Rating >= n ? "#F5A623" : "var(--c-border)")">
                            @(sheet.Rating >= n ? "★" : "☆")
                        </button>
                    }
                </div>
            </div>
            <div class="sheet-actions">
                <button class="act-btn" @onclick="() => OpenEdit(sheet)" @onclick:stopPropagation="true" title="Bearbeiten">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                    </svg>
                </button>
                <button class="act-btn act-delete" @onclick="() => DeleteSheet(sheet)" @onclick:stopPropagation="true" title="Löschen">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/>
                    </svg>
                </button>
            </div>
        </div>
    </div>;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try { _recent = (await JsRuntime.InvokeAsync<string[]>("getRecent")).ToList(); StateHasChanged(); }
        catch { /* localStorage unavailable (e.g. during prerender) — leave recent empty */ }

        if (UpdateService != null)
        {
            if (UpdateService is BasicSheets.Shared.Services.IUpdateServiceNotify notifier)
                notifier.StateChanged += OnUpdateStateChanged;

            await UpdateService.CheckForUpdateAsync();
            StateHasChanged();
        }
    }

    private void OnUpdateStateChanged() => InvokeAsync(StateHasChanged);

    private async Task DoUpdate()
    {
        if (UpdateService is { IsDownloading: false })
            await UpdateService.DownloadAndInstallAsync();
    }

    public void Dispose()
    {
        if (UpdateService is BasicSheets.Shared.Services.IUpdateServiceNotify notifier)
            notifier.StateChanged -= OnUpdateStateChanged;
    }

    private static string DiffLabel(string d) => d switch
    {
        "beginner"     => "Anfänger",
        "intermediate" => "Mittel",
        "advanced"     => "Fortgeschritten",
        "expert"       => "Experte",
        _              => d
    };

    private static int DiffOrder(string d) => d switch
    {
        "beginner" => 0, "intermediate" => 1, "advanced" => 2, "expert" => 3, _ => 4
    };

    private List<Sheet> FilteredSheets
    {
        get
        {
            IEnumerable<Sheet> sheets = SheetService.GetSheets();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                var term = searchText;
                sheets = sheets.Where(s =>
                {
                    if (selectedField == "all")
                        return (s.Name     ?? "").Contains(term, StringComparison.OrdinalIgnoreCase)
                            || (s.Composer ?? "").Contains(term, StringComparison.OrdinalIgnoreCase)
                            || (s.Part     ?? "").Contains(term, StringComparison.OrdinalIgnoreCase)
                            || (s.Genre    ?? "").Contains(term, StringComparison.OrdinalIgnoreCase)
                            || (s.Tags     ?? "").Contains(term, StringComparison.OrdinalIgnoreCase);

                    return selectedField switch
                    {
                        "Name"     => (s.Name     ?? "").Contains(term, StringComparison.OrdinalIgnoreCase),
                        "Composer" => (s.Composer ?? "").Contains(term, StringComparison.OrdinalIgnoreCase),
                        "Part"     => (s.Part     ?? "").Contains(term, StringComparison.OrdinalIgnoreCase),
                        "Genre"    => (s.Genre    ?? "").Contains(term, StringComparison.OrdinalIgnoreCase),
                        "Tags"     => (s.Tags     ?? "").Contains(term, StringComparison.OrdinalIgnoreCase),
                        _          => true
                    };
                });
            }

            return SettingsService.GetSortOrder() switch
            {
                "composer"   => sheets.OrderBy(s => s.Composer ?? "").ThenBy(s => s.Name ?? "").ToList(),
                "date"       => sheets.OrderByDescending(s => s.Updated).ToList(),
                "difficulty" => sheets.OrderBy(s => DiffOrder(s.Difficulty ?? "")).ThenBy(s => s.Name ?? "").ToList(),
                _            => sheets.OrderBy(s => s.Name ?? "").ToList()
            };
        }
    }

    private IEnumerable<IGrouping<string, Sheet>> GroupSheets(string field)
    {
        Func<Sheet, string> key = field == "composer"
            ? (s => string.IsNullOrWhiteSpace(s.Composer) ? "Ohne Komponist" : s.Composer)
            : (s => string.IsNullOrWhiteSpace(s.Genre) ? "Ohne Genre" : s.Genre);

        return SheetService.GetSheets()
                           .OrderBy(s => s.Name ?? "")
                           .GroupBy(key)
                           .OrderBy(g => g.Key, StringComparer.CurrentCultureIgnoreCase);
    }

    private async Task DeleteSheet(Sheet sheet)
    {
        statusMessage = null;
        try
        {
            bool ok = await JsRuntime.InvokeAsync<bool>("confirm", $"«{sheet.Name}» wirklich löschen?");
            if (!ok) return;
            SheetService.RemoveSheets(sheet);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            statusMessage = $"Fehler beim Löschen: {ex.Message}";
        }
    }

    private void SetRating(Sheet sheet, int n)
    {
        var nr = sheet.Rating == n ? 0 : n;   // tapping the current rating clears it
        SheetService.SetRating(sheet.FilePath, nr);
        sheet.Rating = nr;
        StateHasChanged();
    }

    private void OpenSheet(Sheet sheet)
    {
        var fileName = Path.GetFileName(sheet.FilePath);
        if (string.IsNullOrEmpty(fileName)) return;
        navigationManager.NavigateTo($"/sheets/{fileName}?sheet={sheet.Id}");
    }

    private void OpenEdit(Sheet sheet)
    {
        var fileName = Path.GetFileName(sheet.FilePath);
        if (string.IsNullOrEmpty(fileName)) return;
        navigationManager.NavigateTo($"/edit/{fileName}");
    }

    private void OpenSetlist(int id) => navigationManager.NavigateTo($"/setlists/{id}");

    private async Task CreateSetlist()
    {
        try
        {
            var name = await JsRuntime.InvokeAsync<string>("prompt", "Name der Setlist:", "Neue Setlist");
            if (name == null) return; // cancelled
            var id = SetlistService.Create(name);
            navigationManager.NavigateTo($"/setlists/{id}");
        }
        catch (Exception ex) { statusMessage = $"Fehler: {ex.Message}"; }
    }

    private async Task DeleteSetlist(int id)
    {
        try
        {
            var sl = SetlistService.Get(id);
            bool ok = await JsRuntime.InvokeAsync<bool>("confirm", $"Setlist «{sl?.Name}» löschen?");
            if (!ok) return;
            SetlistService.Delete(id);
            StateHasChanged();
        }
        catch (Exception ex) { statusMessage = $"Fehler: {ex.Message}"; }
    }
}
