<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BasicSheets.Shared\BasicSheets.Shared.csproj" />
  </ItemGroup>

  <!-- Keep shared-scoped.css in sync with the Shared project's scoped CSS bundle -->
  <Target Name="CopySharedScopedCss" AfterTargets="Build">
    <Copy
      SourceFiles="$(MSBuildThisFileDirectory)..\BasicSheets.Shared\obj\$(Configuration)\net9.0\scopedcss\projectbundle\BasicSheets.Shared.bundle.scp.css"
      DestinationFiles="$(MSBuildThisFileDirectory)wwwroot\shared-scoped.css"
      SkipUnchangedFiles="true" />
  </Target>

</Project>